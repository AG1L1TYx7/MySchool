{
  "name": "smartschool",
  "version": "0.1.0",
  "private": true,
  "description": "SmartSchool: AI-native K-12 learning platform on local infrastructure",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "pnpm --filter @smartschool/api",
    "web": "pnpm --filter @smartschool/web",
    "dev": "pnpm --filter @smartschool/api start:dev",
    "dev:web": "pnpm --filter @smartschool/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:backup": "node tools/db-backup.mjs",
    "db:restore": "node tools/db-restore.mjs",
    "load:seed": "pnpm --filter @smartschool/api db:seed:load",
    "load:test": "node tools/load-test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "prisma",
      "@parcel/watcher",
      "unrs-resolver"
    ],
    "overrides": {
      "mariadb@>=3.4.0 <3.4.6": ">=3.4.6",
      "mysql2@<3.23.1": ">=3.23.1",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "js-yaml@>=5.0.0 <5.4.1": ">=5.4.1",
      "uuid@<11.1.1": ">=11.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "postcss@<8.5.23": ">=8.5.23"
    }
  },
  "devDependencies": {
    "autocannon": "8.0.0"
  }
}
