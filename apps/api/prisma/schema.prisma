  name           String    @map("Name") @db.VarChar(120)
  kind           String    @map("Kind") @db.VarChar(40)
  frequency      String    @map("Frequency") @db.VarChar(10)
  dayOfWeek      Int?      @map("DayOfWeek")
  dayOfMonth     Int?      @map("DayOfMonth")
  hour           Int       @default(7) @map("Hour")
  classId        String?   @map("ClassId") @db.Char(36)
  recipients     String    @map("Recipients") @db.Text
  active         Boolean   @default(true) @map("Active")
  createdById    String    @map("CreatedById") @db.Char(36)
  lastRunAt      DateTime? @map("LastRunAt") @db.DateTime(6)
  nextRunAt      DateTime  @map("NextRunAt") @db.DateTime(6)
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  runs         ReportRun[]

  @@index([organizationId, active])
  @@index([active, nextRunAt])
  @@map("ReportSchedules")
}

model ReportRun {
  id             String    @id @map("Id") @db.Char(36)
  scheduleId     String?   @map("ScheduleId") @db.Char(36)
  organizationId String    @map("OrganizationId") @db.Char(36)
  kind           String    @map("Kind") @db.VarChar(40)
  status         String    @map("Status") @db.VarChar(10)
  delivered      Boolean   @default(false) @map("Delivered")
  recipients     String    @map("Recipients") @db.Text
  rowCount       Int       @default(0) @map("RowCount")
  fileName       String    @map("FileName") @db.VarChar(160)
  error          String?   @map("Error") @db.Text
  startedAt      DateTime  @default(now()) @map("StartedAt") @db.DateTime(6)
  finishedAt     DateTime? @map("FinishedAt") @db.DateTime(6)

  schedule     ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([scheduleId, startedAt])
  @@map("ReportRuns")
}

/// Push (slice 18): a phone or browser that registered for push notifications.
model PushDevice {
  id         String    @id @map("Id") @db.Char(36)
  userId     String    @map("UserId") @db.Char(36)
  platform   String    @map("Platform") @db.VarChar(10)
  token      String    @unique @map("Token") @db.VarChar(512)
  name       String?   @map("Name") @db.VarChar(120)
  appVersion String?   @map("AppVersion") @db.VarChar(40)
  locale     String?   @map("Locale") @db.VarChar(10)
  lastSeenAt DateTime  @default(now()) @map("LastSeenAt") @db.DateTime(6)
  disabledAt DateTime? @map("DisabledAt") @db.DateTime(6)
  createdAt  DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PushLog[]

  @@index([userId, disabledAt])
  @@index([lastSeenAt])
  @@map("PushDevices")
}

model PushLog {
  id             String   @id @map("Id") @db.Char(36)
  userId         String   @map("UserId") @db.Char(36)
  deviceId       String?  @map("DeviceId") @db.Char(36)
  notificationId String?  @map("NotificationId") @db.Char(36)
  title          String   @map("Title") @db.VarChar(200)
  status         String   @map("Status") @db.VarChar(12)
  error          String?  @map("Error") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device PushDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("PushLogs")
}

/// Compliance (slice 19): a request to erase a student's records, with a grace period and an administrator's approval.
model DeletionRequest {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String    @map("OrganizationId") @db.Char(36)
  studentId      String?   @map("StudentId") @db.Char(36)
  studentName    String    @map("StudentName") @db.VarChar(200)
  studentNumber  String    @map("StudentNumber") @db.VarChar(50)
  requestedById  String    @map("RequestedById") @db.Char(36)
  reason         String?   @map("Reason") @db.VarChar(1000)
  status         String    @default("pending") @map("Status") @db.VarChar(12)
  scheduledFor   DateTime? @map("ScheduledFor") @db.DateTime(6)
  decidedById    String?   @map("DecidedById") @db.Char(36)
  decidedAt      DateTime? @map("DecidedAt") @db.DateTime(6)
  completedAt    DateTime? @map("CompletedAt") @db.DateTime(6)
  summary        String?   @map("Summary") @db.Text
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  requestedBy  User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, scheduledFor])
  @@map("DeletionRequests")
}

/// A security incident and its timeline, for the breach-notification runbook (docs/18).
model SecurityIncident {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String?   @map("OrganizationId") @db.Char(36)
  title          String    @map("Title") @db.VarChar(200)
  severity       String    @map("Severity") @db.VarChar(10)
  status         String    @default("open") @map("Status") @db.VarChar(12)
  summary        String    @map("Summary") @db.Text
  affectedCount  Int       @default(0) @map("AffectedCount")
  dataCategories String?   @map("DataCategories") @db.VarChar(500)
  detectedAt     DateTime  @map("DetectedAt") @db.DateTime(6)
  containedAt    DateTime? @map("ContainedAt") @db.DateTime(6)
  notifiedAt     DateTime? @map("NotifiedAt") @db.DateTime(6)
  closedAt       DateTime? @map("ClosedAt") @db.DateTime(6)
  timeline       String    @map("Timeline") @db.Text
  reportedById   String    @map("ReportedById") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User          @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("SecurityIncidents")
}

/// Tenancy (slice 20, ADR-005): a district or hosting customer that owns one or more schools, with its own
/// domain, branding and policy switches. Every organisation belongs to exactly one tenant.
model Tenant {
  id               String    @id @map("Id") @db.Char(36)
  name             String    @map("Name") @db.VarChar(200)
  slug             String    @unique @map("Slug") @db.VarChar(63)
  status           String    @default("active") @map("Status") @db.VarChar(12)
  customDomain     String?   @unique @map("CustomDomain") @db.VarChar(253)
  domainToken      String?   @map("DomainToken") @db.VarChar(64)
  domainVerifiedAt DateTime? @map("DomainVerifiedAt") @db.DateTime(6)
  branding         String?   @map("Branding") @db.Text
  policies         String?   @map("Policies") @db.Text
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt        DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organizations Organization[]

  @@map("Tenants")
}

/// Integrations (slice 21): webhooks for IT systems. The secret signs every delivery; it is shown once at creation.
model WebhookSubscription {
  id              String    @id @map("Id") @db.Char(36)
  organizationId  String    @map("OrganizationId") @db.Char(36)
  name            String    @map("Name") @db.VarChar(100)
  url             String    @map("Url") @db.VarChar(500)
  secret          String    @map("Secret") @db.VarChar(128)
  events          String?   @map("Events") @db.Text
  isActive        Boolean   @default(true) @map("IsActive")
  retryLimit      Int       @default(5) @map("RetryLimit")
  failureCount    Int       @default(0) @map("FailureCount")
  lastDeliveredAt DateTime? @map("LastDeliveredAt") @db.DateTime(6)
  createdById     String?   @map("CreatedById") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt       DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, isActive])
  @@map("WebhookSubscriptions")
}

model WebhookDelivery {
  id             String    @id @map("Id") @db.Char(36)
  subscriptionId String    @map("SubscriptionId") @db.Char(36)
  organizationId String    @map("OrganizationId") @db.Char(36)
  eventId        String    @map("EventId") @db.Char(36)
  eventType      String    @map("EventType") @db.VarChar(100)
  payload        String    @map("Payload") @db.Text
  status         String    @default("pending") @map("Status") @db.VarChar(16)
  attempts       Int       @default(0) @map("Attempts")
  responseCode   Int?      @map("ResponseCode")
  lastError      String?   @map("LastError") @db.VarChar(500)
  nextAttemptAt  DateTime  @map("NextAttemptAt") @db.DateTime(6)
  deliveredAt    DateTime? @map("DeliveredAt") @db.DateTime(6)
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("WebhookDeliveries")
}

/// API keys for district integrations: the key acts with the authority of the administrator who created it, limited to its scopes.
model ApiKey {
  id                 String    @id @map("Id") @db.Char(36)
  organizationId     String    @map("OrganizationId") @db.Char(36)
  name               String    @map("Name") @db.VarChar(100)
  prefix             String    @unique @map("Prefix") @db.VarChar(16)
  keyHash            String    @map("KeyHash") @db.VarChar(128)
  scopes             String    @map("Scopes") @db.Text
  rateLimitPerMinute Int       @default(600) @map("RateLimitPerMinute")
  createdById        String    @map("CreatedById") @db.Char(36)
  lastUsedAt         DateTime? @map("LastUsedAt") @db.DateTime(6)
  expiresAt          DateTime? @map("ExpiresAt") @db.DateTime(6)
  revokedAt          DateTime? @map("RevokedAt") @db.DateTime(6)
  createdAt          DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
  @@map("ApiKeys")
}

/// LTI 1.3: a platform (Canvas, Schoology) that launches SmartSchool as a tool.
model LtiPlatform {
  id               String   @id @map("Id") @db.Char(36)
  organizationId   String   @map("OrganizationId") @db.Char(36)
  name             String   @map("Name") @db.VarChar(100)
  issuer           String   @map("Issuer") @db.VarChar(500)
  clientId         String   @map("ClientId") @db.VarChar(200)
  deploymentId     String?  @map("DeploymentId") @db.VarChar(200)
  authorizationUrl String   @map("AuthorizationUrl") @db.VarChar(500)
  jwksUrl          String   @map("JwksUrl") @db.VarChar(500)
  tokenUrl         String?  @map("TokenUrl") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("IsActive")
  createdAt        DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt        DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userLinks    LtiUserLink[]

  @@unique([issuer, clientId])
  @@index([organizationId])
  @@map("LtiPlatforms")
}

/// Which SmartSchool user an LTI platform's subject is.
model LtiUserLink {
  id         String   @id @map("Id") @db.Char(36)
  platformId String   @map("PlatformId") @db.Char(36)
  subject    String   @map("Subject") @db.VarChar(255)
  userId     String   @map("UserId") @db.Char(36)
  createdAt  DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  platform LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platformId, subject])
  @@index([userId])
  @@map("LtiUserLinks")
}

/// LTI 1.3: an external tool SmartSchool launches as a platform.
model LtiTool {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String   @map("OrganizationId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(100)
  clientId       String   @unique @map("ClientId") @db.VarChar(64)
  deploymentId   String   @map("DeploymentId") @db.VarChar(64)
  loginUrl       String   @map("LoginUrl") @db.VarChar(500)
  launchUrl      String   @map("LaunchUrl") @db.VarChar(500)
  jwksUrl        String?  @map("JwksUrl") @db.VarChar(500)
  customParams   String?  @map("CustomParams") @db.Text
  isActive       Boolean  @default(true) @map("IsActive")
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("LtiTools")
}

/// The signing key SmartSchool uses for LTI (one active row; rotated by inserting a new one).
model LtiKey {
  id         String   @id @map("Id") @db.Char(36)
  kid        String   @unique @map("Kid") @db.VarChar(64)
  privatePem String   @map("PrivatePem") @db.Text
  publicJwk  String   @map("PublicJwk") @db.Text
  createdAt  DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  @@map("LtiKeys")
}

/// Library (slice 22): one shared catalogue of interactive content, documents, links and lesson plans,
/// with versions, ratings, flags, collections, visibility by school, district or everyone, and moderation.
model LibraryItem {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String    @map("OrganizationId") @db.Char(36)
  createdById    String?   @map("CreatedById") @db.Char(36)
  kind           String    @map("Kind") @db.VarChar(20)
  title          String    @map("Title") @db.VarChar(200)
  description    String?   @map("Description") @db.Text
  subject        String?   @map("Subject") @db.VarChar(100)
  gradeLevel     String?   @map("GradeLevel") @db.VarChar(16)
  topics         String?   @map("Topics") @db.Text
  standards      String?   @map("Standards") @db.Text
  keywords       String?   @map("Keywords") @db.VarChar(500)
  visibility     String    @default("private") @map("Visibility") @db.VarChar(16)
  status         String    @default("draft") @map("Status") @db.VarChar(20)
  h5pContentId   String?   @map("H5PContentId") @db.Char(36)
  fileId         String?   @map("FileId") @db.Char(36)
  url            String?   @map("Url") @db.VarChar(500)
  lessonPlanId   String?   @map("LessonPlanId") @db.Char(36)
  version        Int       @default(1) @map("Version")
  featured       Boolean   @default(false) @map("Featured")
  viewCount      Int       @default(0) @map("ViewCount")
  downloadCount  Int       @default(0) @map("DownloadCount")
  copyCount      Int       @default(0) @map("CopyCount")
  ratingSum      Int       @default(0) @map("RatingSum")
  ratingCount    Int       @default(0) @map("RatingCount")
  sourceItemId   String?   @map("SourceItemId") @db.Char(36)
  publishedAt    DateTime? @map("PublishedAt") @db.DateTime(6)
  reviewedById   String?   @map("ReviewedById") @db.Char(36)
  reviewedAt     DateTime? @map("ReviewedAt") @db.DateTime(6)
  reviewNote     String?   @map("ReviewNote") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime? @map("DeletedAt") @db.DateTime(6)

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  h5pContent      H5PContent?             @relation(fields: [h5pContentId], references: [id], onDelete: SetNull)
  file            FileUpload?             @relation(fields: [fileId], references: [id], onDelete: SetNull)
  lessonPlan      LessonPlan?             @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  versions        LibraryItemVersion[]
  ratings         LibraryRating[]
  flags           LibraryFlag[]
  collectionItems LibraryCollectionItem[]

  @@index([organizationId, status, deletedAt])
  @@index([visibility, status, publishedAt])
  @@index([subject, gradeLevel])
  @@index([createdById])
  @@map("LibraryItems")
}

model LibraryItemVersion {
  id          String   @id @map("Id") @db.Char(36)
  itemId      String   @map("ItemId") @db.Char(36)
  version     Int      @map("Version")
  title       String   @map("Title") @db.VarChar(200)
  description String?  @map("Description") @db.Text
  snapshot    String   @map("Snapshot") @db.LongText
  note        String?  @map("Note") @db.VarChar(300)
  createdById String?  @map("CreatedById") @db.Char(36)
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  item LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
  @@map("LibraryItemVersions")
}

model LibraryRating {
  id        String   @id @map("Id") @db.Char(36)
  itemId    String   @map("ItemId") @db.Char(36)
  userId    String   @map("UserId") @db.Char(36)
  stars     Int      @map("Stars")
  comment   String?  @map("Comment") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  item LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@map("LibraryRatings")
}

model LibraryFlag {
  id           String    @id @map("Id") @db.Char(36)
  itemId       String    @map("ItemId") @db.Char(36)
  userId       String    @map("UserId") @db.Char(36)
  reason       String    @map("Reason") @db.VarChar(500)
  status       String    @default("open") @map("Status") @db.VarChar(16)
  resolvedById String?   @map("ResolvedById") @db.Char(36)
  resolvedAt   DateTime? @map("ResolvedAt") @db.DateTime(6)
  resolution   String?   @map("Resolution") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  item LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([itemId])
  @@map("LibraryFlags")
}

model LibraryCollection {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String    @map("OrganizationId") @db.Char(36)
  createdById    String?   @map("CreatedById") @db.Char(36)
  title          String    @map("Title") @db.VarChar(200)
  description    String?   @map("Description") @db.Text
  visibility     String    @default("private") @map("Visibility") @db.VarChar(16)
  featured       Boolean   @default(false) @map("Featured")
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime? @map("DeletedAt") @db.DateTime(6)

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items        LibraryCollectionItem[]
  followers    LibraryCollectionFollower[]

  @@index([organizationId, visibility, deletedAt])
  @@map("LibraryCollections")
}

model LibraryCollectionItem {
  id           String   @id @map("Id") @db.Char(36)
  collectionId String   @map("CollectionId") @db.Char(36)
  itemId       String   @map("ItemId") @db.Char(36)
  sortOrder    Int      @default(0) @map("SortOrder")
  addedAt      DateTime @default(now()) @map("AddedAt") @db.DateTime(6)

  collection LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item       LibraryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemId])
  @@map("LibraryCollectionItems")
}

model LibraryCollectionFollower {
  id           String   @id @map("Id") @db.Char(36)
  collectionId String   @map("CollectionId") @db.Char(36)
  userId       String   @map("UserId") @db.Char(36)
  createdAt    DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  collection LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@map("LibraryCollectionFollowers")
}
