  muted          Boolean   @default(false) @map("Muted")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("ConversationParticipants")
}

model Message {
  id               String    @id @map("Id") @db.Char(36)
  conversationId   String    @map("ConversationId") @db.Char(36)
  senderId         String?   @map("SenderId") @db.Char(36)
  content          String    @map("Content") @db.Text
  replyToMessageId String?   @map("ReplyToMessageId") @db.Char(36)
  editedAt         DateTime? @map("EditedAt") @db.DateTime(6)
  deletedAt        DateTime? @map("DeletedAt") @db.DateTime(6)
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?      @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("MessageReplies")
  files        MessageFile[]

  @@index([conversationId, createdAt])
  @@map("Messages")
}

model MessageFile {
  id        String @id @map("Id") @db.Char(36)
  messageId String @map("MessageId") @db.Char(36)
  fileId    String @map("FileId") @db.Char(36)

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    FileUpload @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@map("MessageFiles")
}

// ---------------------------------------------------------------------------
// Rostering and sign-in (docs/13 section 2, ADR-025). Release 2 slice 9.
// ---------------------------------------------------------------------------

model UserIdentity {
  id       String           @id @map("Id") @db.Char(36)
  userId   String           @map("UserId") @db.Char(36)
  provider IdentityProvider @map("Provider")
  subject  String           @map("Subject") @db.VarChar(255)
  email    String?          @map("Email") @db.VarChar(256)
  linkedAt DateTime         @default(now()) @map("LinkedAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("UserIdentities")
}

model RosterSource {
  id             String         @id @map("Id") @db.Char(36)
  organizationId String         @map("OrganizationId") @db.Char(36)
  provider       RosterProvider @map("Provider")
  name           String         @map("Name") @db.VarChar(120)
  config         String         @map("Config") @db.Text
  isEnabled      Boolean        @default(true) @map("IsEnabled")
  lastRunAt      DateTime?      @map("LastRunAt") @db.DateTime(6)
  createdAt      DateTime       @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime       @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         RosterSyncRun[]

  @@index([organizationId])
  @@map("RosterSources")
}

model RosterSyncRun {
  id             String          @id @map("Id") @db.Char(36)
  sourceId       String?         @map("SourceId") @db.Char(36)
  organizationId String          @map("OrganizationId") @db.Char(36)
  provider       RosterProvider  @map("Provider")
  status         RosterRunStatus @default(QUEUED) @map("Status")
  dryRun         Boolean         @default(false) @map("DryRun")
  triggeredById  String?         @map("TriggeredById") @db.Char(36)
  startedAt      DateTime        @default(now()) @map("StartedAt") @db.DateTime(6)
  finishedAt     DateTime?       @map("FinishedAt") @db.DateTime(6)
  summary        String?         @map("Summary") @db.Text
  errorMessage   String?         @map("ErrorMessage") @db.Text

  source      RosterSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  triggeredBy User?             @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  errors      RosterSyncError[]

  @@index([organizationId, startedAt])
  @@map("RosterSyncRuns")
}

model RosterSyncError {
  id         String  @id @map("Id") @db.Char(36)
  runId      String  @map("RunId") @db.Char(36)
  entityType String  @map("EntityType") @db.VarChar(40)
  externalId String? @map("ExternalId") @db.VarChar(128)
  message    String  @map("Message") @db.VarChar(500)

  run RosterSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("RosterSyncErrors")
}

// ---------------------------------------------------------------------------
// School structure and calendar (docs/13 sections 3 and 5). Release 2 slice 10.
// ---------------------------------------------------------------------------

model AcademicYear {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String   @map("OrganizationId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(50)
  startDate      DateTime @map("StartDate") @db.Date
  endDate        DateTime @map("EndDate") @db.Date
  isCurrent      Boolean  @default(false) @map("IsCurrent")
  externalId     String?  @map("ExternalId") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms        Term[]
  classes      Class[]

  @@unique([organizationId, name])
  @@map("AcademicYears")
}

model Term {
  id             String   @id @map("Id") @db.Char(36)
  academicYearId String   @map("AcademicYearId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(50)
  type           TermType @default(SEMESTER) @map("Type")
  startDate      DateTime @map("StartDate") @db.Date
  endDate        DateTime @map("EndDate") @db.Date
  sortOrder      Int      @default(0) @map("SortOrder")
  externalId     String?  @map("ExternalId") @db.VarChar(128)

  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradingPeriods GradingPeriod[]
  classes        Class[]

  @@unique([academicYearId, name])
  @@map("Terms")
}

model GradingPeriod {
  id        String   @id @map("Id") @db.Char(36)
  termId    String   @map("TermId") @db.Char(36)
  name      String   @map("Name") @db.VarChar(50)
  startDate DateTime @map("StartDate") @db.Date
  endDate   DateTime @map("EndDate") @db.Date
  sortOrder Int      @default(0) @map("SortOrder")

  term        Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  reportCards ReportCard[]

  @@unique([termId, name])
  @@map("GradingPeriods")
}

model BellSchedule {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String   @map("OrganizationId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(80)
  isDefault      Boolean  @default(false) @map("IsDefault")
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      Period[]

  @@unique([organizationId, name])
  @@map("BellSchedules")
}

model Period {
  id             String @id @map("Id") @db.Char(36)
  bellScheduleId String @map("BellScheduleId") @db.Char(36)
  name           String @map("Name") @db.VarChar(20)
  startTime      String @map("StartTime") @db.VarChar(5)
  endTime        String @map("EndTime") @db.VarChar(5)
  days           String @default("MTWRF") @map("Days") @db.VarChar(7)
  sortOrder      Int    @default(0) @map("SortOrder")

  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)
  classes      Class[]
  attendance   Attendance[]

  @@unique([bellScheduleId, name])
  @@map("Periods")
}

model AttendanceCode {
  id              String             @id @map("Id") @db.Char(36)
  organizationId  String             @map("OrganizationId") @db.Char(36)
  code            String             @map("Code") @db.VarChar(10)
  label           String             @map("Label") @db.VarChar(60)
  category        AttendanceCategory @map("Category")
  countsAsPresent Boolean            @default(false) @map("CountsAsPresent")
  isActive        Boolean            @default(true) @map("IsActive")
  sortOrder       Int                @default(0) @map("SortOrder")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendance   Attendance[]

  @@unique([organizationId, code])
  @@map("AttendanceCodes")
}

model CalendarEvent {
  id             String            @id @map("Id") @db.Char(36)
  organizationId String            @map("OrganizationId") @db.Char(36)
  classId        String?           @map("ClassId") @db.Char(36)
  type           CalendarEventType @default(SCHOOL_EVENT) @map("Type")
  title          String            @map("Title") @db.VarChar(200)
  description    String?           @map("Description") @db.Text
  startsAt       DateTime          @map("StartsAt") @db.DateTime(6)
  endsAt         DateTime?         @map("EndsAt") @db.DateTime(6)
  allDay         Boolean           @default(true) @map("AllDay")
  createdById    String?           @map("CreatedById") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime          @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([classId, startsAt])
  @@map("CalendarEvents")
}

// ---------------------------------------------------------------------------
// Feature permissions and flags (docs/02 section 2)
// ---------------------------------------------------------------------------

model Feature {
  id          String   @id @map("Id") @db.Char(36)
  code        String   @unique @map("Code") @db.VarChar(100)
  name        String   @map("Name") @db.VarChar(200)
  description String?  @map("Description") @db.Text
  category    String   @map("Category") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("IsActive")
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  roleFeatures RoleFeature[]
  overrides    UserFeatureOverride[]

  @@index([category])
  @@map("Features")
}

model RoleFeature {
  id         String   @id @map("Id") @db.Char(36)
  role       Role     @map("Role")
  featureId  String   @map("FeatureId") @db.Char(36)
  assignedBy String?  @map("AssignedBy") @db.Char(36)
  assignedAt DateTime @default(now()) @map("AssignedAt") @db.DateTime(6)

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([role, featureId])
  @@index([featureId])
  @@map("RoleFeatures")
}

model UserFeatureOverride {
  id         String    @id @map("Id") @db.Char(36)
  userId     String    @map("UserId") @db.Char(36)
  featureId  String    @map("FeatureId") @db.Char(36)
  isGranted  Boolean   @map("IsGranted")
  reason     String?   @map("Reason") @db.Text
  assignedBy String?   @map("AssignedBy") @db.Char(36)
  expiresAt  DateTime? @map("ExpiresAt") @db.DateTime(6)
  createdAt  DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([featureId])
  @@map("UserFeatureOverrides")
}

model FeatureFlag {
  id          String   @id @map("Id") @db.Char(36)
  name        String   @unique @map("Name") @db.VarChar(100)
  isEnabled   Boolean  @default(false) @map("IsEnabled")
  description String?  @map("Description") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  @@map("FeatureFlags")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @map("Id") @db.Char(36)
  userId         String?  @map("UserId") @db.Char(36)
  organizationId String?  @map("OrganizationId") @db.Char(36)
  action         String   @map("Action") @db.VarChar(100)
  entityType     String?  @map("EntityType") @db.VarChar(100)
  entityId       String?  @map("EntityId") @db.VarChar(100)
  ipAddress      String?  @map("IpAddress") @db.VarChar(45)
  userAgent      String?  @map("UserAgent") @db.VarChar(500)
  requestPath    String?  @map("RequestPath") @db.VarChar(500)
  httpMethod     String?  @map("HttpMethod") @db.VarChar(10)
  statusCode     Int?     @map("StatusCode")
  details        String?  @map("Details") @db.Text // JSON document
  traceId        String?  @map("TraceId") @db.VarChar(64)
  timestamp      DateTime @default(now()) @map("Timestamp") @db.DateTime(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
  @@index([action, timestamp])
  @@index([entityType, entityId])
  @@map("AuditLogs")
}

// ---------------------------------------------------------------------------
// Platform (ADR-007)
// ---------------------------------------------------------------------------

model JobRun {
  jobName    String    @id @map("JobName") @db.VarChar(100)
  lockedAt   DateTime? @map("LockedAt") @db.DateTime(6)
  lockedBy   String?   @map("LockedBy") @db.VarChar(100)
  lastRunAt  DateTime? @map("LastRunAt") @db.DateTime(6)
  lastStatus String?   @map("LastStatus") @db.VarChar(20)
  lastError  String?   @map("LastError") @db.Text
  runCount   Int       @default(0) @map("RunCount")

  @@map("JobRuns")
}

/// Weighted grade categories per class (docs/13 section 4): Homework 20, Quizzes 30, Tests 50.
model GradeCategory {
  id         String  @id @map("Id") @db.Char(36)
  classId    String  @map("ClassId") @db.Char(36)
  name       String  @map("Name") @db.VarChar(60)
  weight     Decimal @default(0) @map("Weight") @db.Decimal(5, 2)
  dropLowest Int     @default(0) @map("DropLowest")
  sortOrder  Int     @default(0) @map("SortOrder")

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([classId, name])
  @@map("GradeCategories")
}

/// A teacher-set mark that overrides the derived one (Missing counts as zero; Excused is left out).
model AssignmentMark {
  id           String     @id @map("Id") @db.Char(36)
  assignmentId String     @map("AssignmentId") @db.Char(36)
  studentId    String     @map("StudentId") @db.Char(36)
  mark         MarkStatus @map("Mark")
  note         String?    @map("Note") @db.VarChar(500)
  setById      String?    @map("SetById") @db.Char(36)
  updatedAt    DateTime   @updatedAt @map("UpdatedAt") @db.DateTime(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("AssignmentMarks")
}

/// A set of academic standards (Common Core, NGSS, a state set); organisation-less sets are shared by everyone.
model StandardSet {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String?  @map("OrganizationId") @db.Char(36)
  code           String   @map("Code") @db.VarChar(40)
  name           String   @map("Name") @db.VarChar(200)
  subject        String?  @map("Subject") @db.VarChar(100)
  jurisdiction   String?  @map("Jurisdiction") @db.VarChar(100)
  sourceUri      String?  @map("SourceUri") @db.VarChar(500)
  version        String?  @map("Version") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standards    Standard[]

  @@index([organizationId, code])
  @@map("StandardSets")
}

model Standard {
  id          String  @id @map("Id") @db.Char(36)
  setId       String  @map("SetId") @db.Char(36)
  parentId    String? @map("ParentId") @db.Char(36)
  code        String  @map("Code") @db.VarChar(80)
  description String  @map("Description") @db.Text
  gradeLevels String? @map("GradeLevels") @db.VarChar(100)
  sortOrder   Int     @default(0) @map("SortOrder")

  set         StandardSet          @relation(fields: [setId], references: [id], onDelete: Cascade)
  parent      Standard?            @relation("StandardTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Standard[]           @relation("StandardTree")
  assignments AssignmentStandard[]
  lessons     LessonStandard[]
  scores      StandardScore[]

  mastery MasteryLevel[]

  @@unique([setId, code])
  @@index([setId, gradeLevels])
  @@map("Standards")
}

model AssignmentStandard {
  assignmentId String @map("AssignmentId") @db.Char(36)
  standardId   String @map("StandardId") @db.Char(36)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  standard   Standard   @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([assignmentId, standardId])
  @@map("AssignmentStandards")
}

model LessonStandard {
  lessonId   String @map("LessonId") @db.Char(36)
  standardId String @map("StandardId") @db.Char(36)

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([lessonId, standardId])
  @@map("LessonStandards")
}

/// Levels for standards-based grading, e.g. Beginning 1, Developing 2, Proficient 3, Advanced 4 (JSON in Levels).
model ProficiencyScale {
  id             String  @id @map("Id") @db.Char(36)
  organizationId String  @map("OrganizationId") @db.Char(36)
  name           String  @map("Name") @db.VarChar(80)
  levels         String  @map("Levels") @db.Text
  isDefault      Boolean @default(false) @map("IsDefault")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classes      Class[]

  @@unique([organizationId, name])
  @@map("ProficiencyScales")
}

/// The level a student reached on one standard in one graded assignment.
model StandardScore {
  id         String @id @map("Id") @db.Char(36)
  gradeId    String @map("GradeId") @db.Char(36)
  standardId String @map("StandardId") @db.Char(36)
  level      Int    @map("Level")
  label      String @map("Label") @db.VarChar(40)

  grade    Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([gradeId, standardId])
  @@map("StandardScores")
}

/// A report card or progress report for one student and grading period: a snapshot, with teacher comments.
model ReportCard {
  id              String           @id @map("Id") @db.Char(36)
  organizationId  String           @map("OrganizationId") @db.Char(36)
  studentId       String           @map("StudentId") @db.Char(36)
  gradingPeriodId String           @map("GradingPeriodId") @db.Char(36)
  kind            ReportCardKind   @default(REPORT_CARD) @map("Kind")
  status          ReportCardStatus @default(DRAFT) @map("Status")
  gpa             Decimal?         @map("GPA") @db.Decimal(4, 2)
  attendance      String?          @map("Attendance") @db.Text
  generatedById   String?          @map("GeneratedById") @db.Char(36)
  publishedAt     DateTime?        @map("PublishedAt") @db.DateTime(6)
  createdAt       DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt       DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradingPeriod GradingPeriod    @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)
  lines         ReportCardLine[]

  @@unique([studentId, gradingPeriodId, kind])
  @@index([organizationId, gradingPeriodId, status])
  @@map("ReportCards")
}

model ReportCardLine {
  id           String   @id @map("Id") @db.Char(36)
  reportCardId String   @map("ReportCardId") @db.Char(36)
  classId      String   @map("ClassId") @db.Char(36)
  className    String   @map("ClassName") @db.VarChar(200)
  courseTitle  String   @map("CourseTitle") @db.VarChar(200)
  teacherName  String?  @map("TeacherName") @db.VarChar(200)
  percentage   Decimal? @map("Percentage") @db.Decimal(5, 2)
  letter       String?  @map("Letter") @db.VarChar(4)
  gpaPoints    Decimal? @map("GpaPoints") @db.Decimal(4, 2)
  categories   String?  @map("Categories") @db.Text
  standards    String?  @map("Standards") @db.Text
  comment      String?  @map("Comment") @db.Text
  commentById  String?  @map("CommentById") @db.Char(36)
  updatedAt    DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([reportCardId, classId])
  @@map("ReportCardLines")
}

/// IEP and 504 accommodations applied in the product (docs/13 section 6); one active plan per student.
model Accommodation {
  id                  String            @id @map("Id") @db.Char(36)
  organizationId      String            @map("OrganizationId") @db.Char(36)
  studentId           String            @unique @map("StudentId") @db.Char(36)
  plan                AccommodationPlan @default(OTHER) @map("Plan")
  extendedTimePercent Int               @default(0) @map("ExtendedTimePercent")
  readAloud           Boolean           @default(false) @map("ReadAloud")
  largeText           Boolean           @default(false) @map("LargeText")
  reducedMotion       Boolean           @default(false) @map("ReducedMotion")
  reducedDistraction  Boolean           @default(false) @map("ReducedDistraction")
  notes               String?           @map("Notes") @db.Text
  startDate           DateTime?         @map("StartDate") @db.Date
  endDate             DateTime?         @map("EndDate") @db.Date
  updatedById         String?           @map("UpdatedById") @db.Char(36)
  createdAt           DateTime          @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt           DateTime          @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, plan])
  @@map("Accommodations")
}

model CounselorCaseload {
  id          String   @id @map("Id") @db.Char(36)
  counselorId String   @map("CounselorId") @db.Char(36)
  studentId   String   @map("StudentId") @db.Char(36)
  reason      String?  @map("Reason") @db.VarChar(200)
  assignedAt  DateTime @default(now()) @map("AssignedAt") @db.DateTime(6)

  counselor User    @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([counselorId, studentId])
  @@index([studentId])
  @@map("CounselorCaseloads")
}

/// Private to counselors: never shown to teachers, parents or students.
model CounselorNote {
  id        String   @id @map("Id") @db.Char(36)
  studentId String   @map("StudentId") @db.Char(36)
  authorId  String   @map("AuthorId") @db.Char(36)
  body      String   @map("Body") @db.Text
  createdAt DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("CounselorNotes")
}

/// Raised when the tutor safety classifier escalates; worked by counselors.
model WellnessAlert {
  id             String         @id @map("Id") @db.Char(36)
  organizationId String         @map("OrganizationId") @db.Char(36)
  studentId      String?        @map("StudentId") @db.Char(36)
  userId         String         @map("UserId") @db.Char(36)
