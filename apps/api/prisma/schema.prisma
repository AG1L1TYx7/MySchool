// SmartSchool LMS schema (docs/03-DATA-MODEL.md).
//
// Conventions (ADR-003, ADR-020): PascalCase table and column names in the database,
// camelCase fields in Prisma via @map, application-generated UUID v7 keys stored as
// char(36), UTC datetime(6), soft delete via DeletedAt where listed in docs/03 section 4.
// The 12 AI-owned tables (added in Release 1 slice 5 and Release 2) keep the exact
// names and columns the Python service expects.
//
// Release 1 slice 1: identity and access.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums (stored as MySQL ENUM on tables this API owns)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  SUPERINTENDENT
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ASSISTANT
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

enum LearningStyle {
  VISUAL
  AUDITORY
  KINESTHETIC
  READING_WRITING
  MIXED
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  UNDER_REVIEW
}

enum LessonType {
  TEXT
  VIDEO
  DOCUMENT
  LINK
  INTERACTIVE
}

enum GradingMode {
  POINTS
  STANDARDS
}

enum MarkStatus {
  MISSING
  EXCUSED
  INCOMPLETE
}

enum ReportCardKind {
  PROGRESS
  REPORT_CARD
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

enum ClassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClassEnrollmentStatus {
  ENROLLED
  WAITLISTED
  DROPPED
  COMPLETED
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
  INVITE
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  TEST
  PROJECT
  ESSAY
  PRESENTATION
  LAB
  DISCUSSION
  PRACTICE
}

enum SubmissionType {
  ONLINE
  PAPER
  IN_PERSON
  EXTERNAL
  NO_SUBMISSION
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  TARDY
  LEFT_EARLY
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiMessageStatus {
  OK
  REFUSED
  DEGRADED
  UNAVAILABLE
}

enum H5PContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum H5PContentSource {
  AI
  MANUAL
}

enum AiJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AnnouncementType {
  GENERAL
  ACADEMIC
  EVENT
  EMERGENCY
  ADMINISTRATIVE
  SOCIAL
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationCategory {
  ANNOUNCEMENT
  ASSIGNMENT
  GRADE
  MESSAGE
  ATTENDANCE
  SYSTEM
  AI
}

enum ConversationType {
  DIRECT
  GROUP
  CLASS
}

enum RecordSource {
  MANUAL
  ONEROSTER
  CLEVER
  CLASSLINK
}

enum RosterProvider {
  ONEROSTER_CSV
  ONEROSTER_API
  CLEVER
  CLASSLINK
}

enum RosterRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum IdentityProvider {
  GOOGLE
  MICROSOFT
  CLEVER
  CLASSLINK
}

enum TermType {
  SEMESTER
  TRIMESTER
  QUARTER
  TERM
}

enum AttendanceCategory {
  PRESENT
  TARDY
  EXCUSED
  UNEXCUSED
  REMOTE
  OTHER
}

enum CalendarEventType {
  DAY_OFF
  EARLY_RELEASE
  TERM_START
  TERM_END
  SCHOOL_EVENT
  CLASS_EVENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// ---------------------------------------------------------------------------
// Organisation (school-level container; tenancy arrives in Release 3, ADR-019)
// ---------------------------------------------------------------------------

model Organization {
  id                     String    @id @map("Id") @db.Char(36)
  name                   String    @map("Name") @db.VarChar(200)
  description            String?   @map("Description") @db.VarChar(500)
  email                  String?   @map("Email") @db.VarChar(100)
  phone                  String?   @map("Phone") @db.VarChar(20)
  address                String?   @map("Address") @db.VarChar(500)
  timezone               String    @default("UTC") @map("Timezone") @db.VarChar(64)
  isActive               Boolean   @default(true) @map("IsActive")
  joinCode               String?   @unique @map("JoinCode") @db.VarChar(16)
  joinCodeRotatedAt      DateTime? @map("JoinCodeRotatedAt") @db.DateTime(6)
  externalId             String?   @map("ExternalId") @db.VarChar(128)
  ssoProviders           String?   @map("SsoProviders") @db.VarChar(200)
  ssoAllowedDomains      String?   @map("SsoAllowedDomains") @db.VarChar(500)
  ssoPasswordOptional    Boolean   @default(false) @map("SsoPasswordOptional")
  gradeLevels            String?   @map("GradeLevels") @db.VarChar(100)
  attendanceDeadlineTime String?   @map("AttendanceDeadlineTime") @db.VarChar(5)
  gradingScale           String?   @map("GradingScale") @db.Text
  gpaScale               String?   @map("GpaScale") @db.Text
  createdAt              DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt              DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt              DateTime? @map("DeletedAt") @db.DateTime(6)

  users             User[]
  students          Student[]
  courses           Course[]
  classes           Class[]
  files             FileUpload[]
  rubrics           Rubric[]
  assignments       Assignment[]
  aiConversations   AiConversation[]
  h5pContents       H5PContent[]
  standardSets      StandardSet[]
  proficiencyScales ProficiencyScale[]
  reportCards       ReportCard[]
  aiJobs            AiJob[]
  announcements     Announcement[]
  conversations     Conversation[]
  rosterSources     RosterSource[]
  academicYears     AcademicYear[]
  bellSchedules     BellSchedule[]
  attendanceCodes   AttendanceCode[]
  calendarEvents    CalendarEvent[]

  @@index([name])
  @@index([isActive, deletedAt])
  @@map("Organizations")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String     @id @map("Id") @db.Char(36)
  email             String     @unique @map("Email") @db.VarChar(256)
  emailVerifiedAt   DateTime?  @map("EmailVerifiedAt") @db.DateTime(6)
  passwordHash      String     @map("PasswordHash") @db.VarChar(512)
  passwordChangedAt DateTime?  @map("PasswordChangedAt") @db.DateTime(6)
  firstName         String     @map("FirstName") @db.VarChar(100)
  lastName          String     @map("LastName") @db.VarChar(100)
  role              Role       @map("Role")
  status            UserStatus @default(ACTIVE) @map("Status")
  organizationId    String?    @map("OrganizationId") @db.Char(36)
  phone             String?    @map("Phone") @db.VarChar(32)
  locale            String     @default("en") @map("Locale") @db.VarChar(16)
  timezone          String?    @map("Timezone") @db.VarChar(64)
  avatarFileId      String?    @map("AvatarFileId") @db.Char(36)

  twoFactorEnabled Boolean @default(false) @map("TwoFactorEnabled")
  twoFactorSecret  String? @map("TwoFactorSecret") @db.VarChar(512) // AES-256-GCM encrypted
  backupCodes      String? @map("BackupCodes") @db.Text // JSON array of argon2 hashes (TEXT: MariaDB 10.4 has no native JSON, ADR-002)

  lastTotpStep     Int?         @map("LastTotpStep")
  failedLoginCount Int          @default(0) @map("FailedLoginCount")
  lockedUntil      DateTime?    @map("LockedUntil") @db.DateTime(6)
  lastLoginAt      DateTime?    @map("LastLoginAt") @db.DateTime(6)
  externalId       String?      @map("ExternalId") @db.VarChar(128)
  source           RecordSource @default(MANUAL) @map("Source")
  managedBySis     Boolean      @default(false) @map("ManagedBySis")

  createdAt DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt DateTime? @map("DeletedAt") @db.DateTime(6)

  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions           AuthSession[]
  authTokens         AuthToken[]
  featureOverrides   UserFeatureOverride[]
  auditLogs          AuditLog[]
  student            Student?
  guardianLinks      StudentGuardian[]
  coursesInstructed  Course[]                  @relation("CourseInstructor")
  coursesCreated     Course[]                  @relation("CourseCreator")
  classesTaught      ClassTeacher[]
  uploads            FileUpload[]
  rubricsCreated     Rubric[]
  assignmentsCreated Assignment[]
  gradesGiven        Grade[]
  attendanceMarked   Attendance[]
  aiConversations    AiConversation[]
  h5pContents        H5PContent[]
  h5pResults         H5PContentResult[]
  aiJobs             AiJob[]
  announcements      Announcement[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  conversationsMade  Conversation[]
  participations     ConversationParticipant[]
  messagesSent       Message[]
  identities         UserIdentity[]
  rosterRuns         RosterSyncRun[]
  calendarEvents     CalendarEvent[]
  icalToken          String?                   @unique @map("IcalToken") @db.VarChar(64)

  @@index([organizationId, role])
  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@index([organizationId, externalId])
  @@map("Users")
}

/// One row per refresh token. Rotation replaces the row; reuse of a replaced token revokes the family.
model AuthSession {
  id                String    @id @map("Id") @db.Char(36)
  userId            String    @map("UserId") @db.Char(36)
  familyId          String    @map("FamilyId") @db.Char(36)
  refreshTokenHash  String    @unique @map("RefreshTokenHash") @db.Char(64)
  userAgent         String?   @map("UserAgent") @db.VarChar(500)
  ipAddress         String?   @map("IpAddress") @db.VarChar(45)
  rememberMe        Boolean   @default(false) @map("RememberMe")
  createdAt         DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  lastUsedAt        DateTime  @default(now()) @map("LastUsedAt") @db.DateTime(6)
  expiresAt         DateTime  @map("ExpiresAt") @db.DateTime(6)
  revokedAt         DateTime? @map("RevokedAt") @db.DateTime(6)
  replacedById      String?   @map("ReplacedById") @db.Char(36)
  absoluteExpiresAt DateTime? @map("AbsoluteExpiresAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("AuthSessions")
}

/// Single-use emailed tokens: password reset, email verification, invitations. Only the SHA-256 hash is stored.
model AuthToken {
  id        String           @id @map("Id") @db.Char(36)
  userId    String           @map("UserId") @db.Char(36)
  purpose   AuthTokenPurpose @map("Purpose")
  tokenHash String           @unique @map("TokenHash") @db.Char(64)
  expiresAt DateTime         @map("ExpiresAt") @db.DateTime(6)
  usedAt    DateTime?        @map("UsedAt") @db.DateTime(6)
  createdAt DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("AuthTokens")
}

// ---------------------------------------------------------------------------
// Students and guardians (docs/02 section 3). Release 1 slice 2.
// ---------------------------------------------------------------------------

model Student {
  id                     String           @id @map("Id") @db.Char(36)
  organizationId         String           @map("OrganizationId") @db.Char(36)
  userId                 String?          @unique @map("UserId") @db.Char(36)
  studentNumber          String           @map("StudentNumber") @db.VarChar(50)
  firstName              String           @map("FirstName") @db.VarChar(100)
  lastName               String           @map("LastName") @db.VarChar(100)
  email                  String?          @map("Email") @db.VarChar(256)
  phone                  String?          @map("Phone") @db.VarChar(32)
  dateOfBirth            DateTime?        @map("DateOfBirth") @db.Date
  gender                 String?          @map("Gender") @db.VarChar(32)
  gradeLevel             String?          @map("GradeLevel") @db.VarChar(16)
  enrollmentStatus       EnrollmentStatus @default(ACTIVE) @map("EnrollmentStatus")
  enrollmentDate         DateTime?        @map("EnrollmentDate") @db.Date
  preferredLearningStyle LearningStyle?   @map("PreferredLearningStyle")
  accessibilityNeeds     String?          @map("AccessibilityNeeds") @db.Text
  goals                  String?          @map("Goals") @db.Text
  notes                  String?          @map("Notes") @db.Text
  address                String?          @map("Address") @db.VarChar(500)
  gpa                    Decimal?         @map("GPA") @db.Decimal(4, 2)
  attendanceRate         Decimal?         @map("AttendanceRate") @db.Decimal(5, 2)
  externalId             String?          @map("ExternalId") @db.VarChar(128)
  source                 RecordSource     @default(MANUAL) @map("Source")
  managedBySis           Boolean          @default(false) @map("ManagedBySis")
  createdAt              DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt              DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt              DateTime?        @map("DeletedAt") @db.DateTime(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  marks        AssignmentMark[]
  reportCards  ReportCard[]
  guardians    StudentGuardian[]
  enrollments  ClassEnrollment[]
  submissions  AssignmentSubmission[]
  grades       Grade[]
  attendance   Attendance[]
  h5pResults   H5PContentResult[]

  @@unique([organizationId, studentNumber])
  @@index([organizationId, enrollmentStatus, deletedAt])
  @@index([organizationId, gradeLevel])
  @@index([lastName, firstName])
  @@index([organizationId, externalId])
  @@map("Students")
}

model StudentGuardian {
  id                    String               @id @map("Id") @db.Char(36)
  studentId             String               @map("StudentId") @db.Char(36)
  guardianUserId        String               @map("GuardianUserId") @db.Char(36)
  relationship          GuardianRelationship @default(GUARDIAN) @map("Relationship")
  isPrimary             Boolean              @default(false) @map("IsPrimary")
  source                RecordSource         @default(MANUAL) @map("Source")
  receivesNotifications Boolean              @default(true) @map("ReceivesNotifications")
  canViewGrades         Boolean              @default(true) @map("CanViewGrades")
  canViewAttendance     Boolean              @default(true) @map("CanViewAttendance")
  createdAt             DateTime             @default(now()) @map("CreatedAt") @db.DateTime(6)

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian User    @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianUserId])
  @@index([guardianUserId])
  @@map("StudentGuardians")
}

// ---------------------------------------------------------------------------
// Curriculum and classes (docs/02 sections 4 and 5). Release 1 slice 3.
// ---------------------------------------------------------------------------

model Course {
  id             String       @id @map("Id") @db.Char(36)
  organizationId String       @map("OrganizationId") @db.Char(36)
  courseCode     String       @map("CourseCode") @db.VarChar(50)
  title          String       @map("Title") @db.VarChar(200)
  description    String?      @map("Description") @db.Text
  subject        String?      @map("Subject") @db.VarChar(100)
  gradeLevel     String?      @map("GradeLevel") @db.VarChar(16)
  creditHours    Decimal?     @map("CreditHours") @db.Decimal(4, 2)
  estimatedHours Int?         @map("EstimatedHours")
  status         CourseStatus @default(DRAFT) @map("Status")
  isPublished    Boolean      @default(false) @map("IsPublished")
  externalId     String?      @map("ExternalId") @db.VarChar(128)
  source         RecordSource @default(MANUAL) @map("Source")
  publishedAt    DateTime?    @map("PublishedAt") @db.DateTime(6)
  instructorId   String?      @map("InstructorId") @db.Char(36)
  createdById    String?      @map("CreatedById") @db.Char(36)
  clonedFromId   String?      @map("ClonedFromId") @db.Char(36)
  createdAt      DateTime     @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime     @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime?    @map("DeletedAt") @db.DateTime(6)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor    User?                @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules       Module[]
  classes       Class[]
  prerequisites CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredBy    CoursePrerequisite[] @relation("CourseRequiredBy")

  @@unique([organizationId, courseCode])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, subject, gradeLevel])
  @@index([instructorId])
  @@map("Courses")
}

model CoursePrerequisite {
  id                   String @id @map("Id") @db.Char(36)
  courseId             String @map("CourseId") @db.Char(36)
  prerequisiteCourseId String @map("PrerequisiteCourseId") @db.Char(36)

  course       Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("CourseRequiredBy", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
  @@index([prerequisiteCourseId])
  @@map("CoursePrerequisites")
}

model Module {
  id               String   @id @map("Id") @db.Char(36)
  courseId         String   @map("CourseId") @db.Char(36)
  title            String   @map("Title") @db.VarChar(200)
  description      String?  @map("Description") @db.Text
  sortOrder        Int      @default(0) @map("SortOrder")
  isPublished      Boolean  @default(true) @map("IsPublished")
  estimatedMinutes Int?     @map("EstimatedMinutes")
  createdAt        DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt        DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@map("Modules")
}

model Lesson {
  id              String     @id @map("Id") @db.Char(36)
  moduleId        String     @map("ModuleId") @db.Char(36)
  title           String     @map("Title") @db.VarChar(200)
  description     String?    @map("Description") @db.Text
  lessonType      LessonType @default(TEXT) @map("LessonType")
  content         String?    @map("Content") @db.LongText
  contentUrl      String?    @map("ContentUrl") @db.VarChar(2000)
  h5pContentId    String?    @map("H5PContentId") @db.Char(36)
  sortOrder       Int        @default(0) @map("SortOrder")
  durationMinutes Int?       @map("DurationMinutes")
  isPublished     Boolean    @default(true) @map("IsPublished")
  createdAt       DateTime   @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt       DateTime   @updatedAt @map("UpdatedAt") @db.DateTime(6)

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  standards LessonStandard[]

  @@index([moduleId, sortOrder])
  @@map("Lessons")
}

model Class {
  id                 String       @id @map("Id") @db.Char(36)
  organizationId     String       @map("OrganizationId") @db.Char(36)
  courseId           String       @map("CourseId") @db.Char(36)
  name               String       @map("Name") @db.VarChar(200)
  section            String?      @map("Section") @db.VarChar(50)
  term               String       @map("Term") @db.VarChar(50)
  startDate          DateTime?    @map("StartDate") @db.Date
  endDate            DateTime?    @map("EndDate") @db.Date
  room               String?      @map("Room") @db.VarChar(100)
  meetingSchedule    String?      @map("MeetingSchedule") @db.Text
  maxStudents        Int?         @map("MaxStudents")
  periodLabel        String?      @map("PeriodLabel") @db.VarChar(50)
  academicYearId     String?      @map("AcademicYearId") @db.Char(36)
  termId             String?      @map("TermId") @db.Char(36)
  periodId           String?      @map("PeriodId") @db.Char(36)
  gradeLevel         String?      @map("GradeLevel") @db.VarChar(16)
  gradingMode        GradingMode  @default(POINTS) @map("GradingMode")
  proficiencyScaleId String?      @map("ProficiencyScaleId") @db.Char(36)
  latePolicy         String?      @map("LatePolicy") @db.Text
  syllabus           String?      @map("Syllabus") @db.Text
  externalId         String?      @map("ExternalId") @db.VarChar(128)
  source             RecordSource @default(MANUAL) @map("Source")
  managedBySis       Boolean      @default(false) @map("ManagedBySis")
  status             ClassStatus  @default(SCHEDULED) @map("Status")
  createdAt          DateTime     @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt          DateTime     @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt          DateTime?    @map("DeletedAt") @db.DateTime(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teachers         ClassTeacher[]
  enrollments      ClassEnrollment[]
  assignments      Assignment[]
  attendance       Attendance[]
  academicYear     AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  termRef          Term?             @relation(fields: [termId], references: [id], onDelete: SetNull)
  period           Period?           @relation(fields: [periodId], references: [id], onDelete: SetNull)
  calendarEvents   CalendarEvent[]
  gradeCategories  GradeCategory[]
  proficiencyScale ProficiencyScale? @relation(fields: [proficiencyScaleId], references: [id], onDelete: SetNull)
  reportCardLines  ReportCardLine[]
  announcements    Announcement[]
  conversations    Conversation[]

  @@index([organizationId, term, status, deletedAt])
  @@index([courseId])
  @@index([organizationId, externalId])
  @@map("Classes")
}

model ClassTeacher {
  id         String   @id @map("Id") @db.Char(36)
  classId    String   @map("ClassId") @db.Char(36)
  teacherId  String   @map("TeacherId") @db.Char(36)
  isPrimary  Boolean  @default(false) @map("IsPrimary")
  assignedAt DateTime @default(now()) @map("AssignedAt") @db.DateTime(6)

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([teacherId])
  @@map("ClassTeachers")
}

model ClassEnrollment {
  id           String                @id @map("Id") @db.Char(36)
  classId      String                @map("ClassId") @db.Char(36)
  studentId    String                @map("StudentId") @db.Char(36)
  status       ClassEnrollmentStatus @default(ENROLLED) @map("Status")
  externalId   String?               @map("ExternalId") @db.VarChar(128)
  source       RecordSource          @default(MANUAL) @map("Source")
  managedBySis Boolean               @default(false) @map("ManagedBySis")
  enrolledAt   DateTime              @default(now()) @map("EnrolledAt") @db.DateTime(6)
  droppedAt    DateTime?             @map("DroppedAt") @db.DateTime(6)
  currentGrade Decimal?              @map("CurrentGrade") @db.Decimal(5, 2)
  updatedAt    DateTime              @updatedAt @map("UpdatedAt") @db.DateTime(6)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@map("ClassEnrollments")
}

// ---------------------------------------------------------------------------
// Files, assignments, submissions, grades, attendance (docs/02 sections 6, 7, 8, 10). Release 1 slice 4.
// ---------------------------------------------------------------------------

model FileUpload {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String?   @map("OrganizationId") @db.Char(36)
  uploaderId     String    @map("UploaderId") @db.Char(36)
  originalName   String    @map("OriginalName") @db.VarChar(255)
  storedPath     String    @map("StoredPath") @db.VarChar(500)
  mimeType       String    @map("MimeType") @db.VarChar(127)
  sizeBytes      Int       @map("SizeBytes")
  sha256         String    @map("Sha256") @db.Char(64)
  category       String    @default("general") @map("Category") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  deletedAt      DateTime? @map("DeletedAt") @db.DateTime(6)

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploader        User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  submissionFiles SubmissionFile[]
  messageFiles    MessageFile[]

  @@index([organizationId, category, deletedAt])
  @@index([uploaderId])
  @@map("FileUploads")
}

model Rubric {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String    @map("OrganizationId") @db.Char(36)
  createdById    String?   @map("CreatedById") @db.Char(36)
  title          String    @map("Title") @db.VarChar(200)
  description    String?   @map("Description") @db.Text
  criteria       String    @map("Criteria") @db.Text
  isTemplate     Boolean   @default(false) @map("IsTemplate")
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime? @map("DeletedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments  Assignment[]

  @@index([organizationId, deletedAt])
  @@map("Rubrics")
}

model Assignment {
  id                 String           @id @map("Id") @db.Char(36)
  organizationId     String           @map("OrganizationId") @db.Char(36)
  classId            String           @map("ClassId") @db.Char(36)
  createdById        String?          @map("CreatedById") @db.Char(36)
  title              String           @map("Title") @db.VarChar(200)
  description        String?          @map("Description") @db.Text
  instructions       String?          @map("Instructions") @db.Text
  type               AssignmentType   @default(HOMEWORK) @map("Type")
  submissionType     SubmissionType   @default(ONLINE) @map("SubmissionType")
  category           String?          @map("Category") @db.VarChar(50)
  categoryId         String?          @map("CategoryId") @db.Char(36)
  isExtraCredit      Boolean          @default(false) @map("IsExtraCredit")
  gradingPeriodId    String?          @map("GradingPeriodId") @db.Char(36)
  maxPoints          Decimal          @default(100) @map("MaxPoints") @db.Decimal(7, 2)
  weight             Decimal          @default(1) @map("Weight") @db.Decimal(5, 2)
  availableFrom      DateTime?        @map("AvailableFrom") @db.DateTime(6)
  dueAt              DateTime?        @map("DueAt") @db.DateTime(6)
  allowLateUntil     DateTime?        @map("AllowLateUntil") @db.DateTime(6)
  latePenaltyPercent Int?             @map("LatePenaltyPercent")
  maxAttempts        Int?             @map("MaxAttempts")
  rubricId           String?          @map("RubricId") @db.Char(36)
  h5pContentId       String?          @map("H5PContentId") @db.Char(36)
  status             AssignmentStatus @default(DRAFT) @map("Status")
  publishedAt        DateTime?        @map("PublishedAt") @db.DateTime(6)
  createdAt          DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt          DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt          DateTime?        @map("DeletedAt") @db.DateTime(6)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class         Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rubric        Rubric?                @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  h5pContent    H5PContent?            @relation(fields: [h5pContentId], references: [id], onDelete: SetNull)
  h5pResults    H5PContentResult[]
  submissions   AssignmentSubmission[]
  grades        Grade[]
  gradeCategory GradeCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  gradingPeriod GradingPeriod?         @relation(fields: [gradingPeriodId], references: [id], onDelete: SetNull)
  marks         AssignmentMark[]
  standards     AssignmentStandard[]

  @@index([classId, status, dueAt])
  @@index([organizationId, deletedAt])
  @@map("Assignments")
}

model AssignmentSubmission {
  id            String           @id @map("Id") @db.Char(36)
  assignmentId  String           @map("AssignmentId") @db.Char(36)
  studentId     String           @map("StudentId") @db.Char(36)
  attemptNumber Int              @default(1) @map("AttemptNumber")
  status        SubmissionStatus @default(SUBMITTED) @map("Status")
  textContent   String?          @map("TextContent") @db.LongText
  isLate        Boolean          @default(false) @map("IsLate")
  submittedAt   DateTime         @default(now()) @map("SubmittedAt") @db.DateTime(6)
  createdAt     DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt     DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files      SubmissionFile[]
  grade      Grade?

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([studentId, submittedAt])
  @@map("AssignmentSubmissions")
}

model SubmissionFile {
  id           String @id @map("Id") @db.Char(36)
  submissionId String @map("SubmissionId") @db.Char(36)
  fileId       String @map("FileId") @db.Char(36)

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file       FileUpload           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fileId])
  @@index([fileId])
  @@map("SubmissionFiles")
}

model Grade {
  id                 String   @id @map("Id") @db.Char(36)
  assignmentId       String   @map("AssignmentId") @db.Char(36)
  studentId          String   @map("StudentId") @db.Char(36)
  submissionId       String?  @unique @map("SubmissionId") @db.Char(36)
  gradedById         String?  @map("GradedById") @db.Char(36)
  score              Decimal  @map("Score") @db.Decimal(7, 2)
  maxPoints          Decimal  @map("MaxPoints") @db.Decimal(7, 2)
  percentage         Decimal  @map("Percentage") @db.Decimal(5, 2)
  letterGrade        String?  @map("LetterGrade") @db.VarChar(4)
  feedback           String?  @map("Feedback") @db.Text
  rubricScores       String?  @map("RubricScores") @db.Text
  latePenaltyApplied Int?     @map("LatePenaltyApplied")
  gradedAt           DateTime @default(now()) @map("GradedAt") @db.DateTime(6)
  createdAt          DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt          DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  assignment     Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submission     AssignmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  gradedBy       User?                 @relation(fields: [gradedById], references: [id], onDelete: SetNull)
  standardScores StandardScore[]

  @@unique([assignmentId, studentId])
  @@index([studentId, gradedAt])
  @@map("Grades")
}

model Attendance {
  id         String           @id @map("Id") @db.Char(36)
  classId    String           @map("ClassId") @db.Char(36)
  studentId  String           @map("StudentId") @db.Char(36)
  date       DateTime         @map("Date") @db.Date
  status     AttendanceStatus @map("Status")
  notes      String?          @map("Notes") @db.VarChar(500)
  codeId     String?          @map("CodeId") @db.Char(36)
  periodId   String?          @map("PeriodId") @db.Char(36)
  markedById String?          @map("MarkedById") @db.Char(36)
  createdAt  DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt  DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)

  class    Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User?           @relation(fields: [markedById], references: [id], onDelete: SetNull)
  code     AttendanceCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  period   Period?         @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@unique([classId, studentId, date])
  @@index([studentId, date])
  @@index([classId, date])
  @@map("Attendances")
}

// ---------------------------------------------------------------------------
// AI tutor conversations (docs/10). Release 1 slice 5. The AI service keeps traces; the LMS keeps the record.
// ---------------------------------------------------------------------------

model AiConversation {
  id             String    @id @map("Id") @db.Char(36)
  organizationId String?   @map("OrganizationId") @db.Char(36)
  userId         String    @map("UserId") @db.Char(36)
  capability     String    @map("Capability") @db.VarChar(50)
  courseId       String?   @map("CourseId") @db.Char(36)
  lessonId       String?   @map("LessonId") @db.Char(36)
  classId        String?   @map("ClassId") @db.Char(36)
  title          String    @map("Title") @db.VarChar(200)
  summary        String?   @map("Summary") @db.Text
  messageCount   Int       @default(0) @map("MessageCount")
  lastMessageAt  DateTime? @map("LastMessageAt") @db.DateTime(6)
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime? @map("DeletedAt") @db.DateTime(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([userId, lastMessageAt])
  @@index([organizationId, createdAt])
  @@map("AiConversations")
}

model AiMessage {
  id             String          @id @map("Id") @db.Char(36)
  conversationId String          @map("ConversationId") @db.Char(36)
  role           AiMessageRole   @map("Role")
  content        String          @map("Content") @db.LongText
  status         AiMessageStatus @default(OK) @map("Status")
  promptVersion  String?         @map("PromptVersion") @db.VarChar(60)
  model          String?         @map("Model") @db.VarChar(100)
  citations      String?         @map("Citations") @db.Text
  safety         String?         @map("Safety") @db.Text
  usage          String?         @map("Usage") @db.Text
  traceId        String?         @map("TraceId") @db.Char(36)
  feedback       Int?            @map("Feedback")
  createdAt      DateTime        @default(now()) @map("CreatedAt") @db.DateTime(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("AiMessages")
}

// ---------------------------------------------------------------------------
// Interactive content (H5P) and AI generation jobs. Release 1 slice 6, ADR-022.
// ---------------------------------------------------------------------------

model H5PLibrary {
  id           String   @id @map("Id") @db.Char(36)
  machineName  String   @map("MachineName") @db.VarChar(100)
  majorVersion Int      @map("MajorVersion")
  minorVersion Int      @map("MinorVersion")
  patchVersion Int      @map("PatchVersion")
  title        String   @map("Title") @db.VarChar(150)
  runnable     Boolean  @default(false) @map("Runnable")
  restricted   Boolean  @default(false) @map("Restricted")
  dependencies String?  @map("Dependencies") @db.Text
  createdAt    DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  @@unique([machineName, majorVersion, minorVersion, patchVersion])
  @@map("H5PLibraries")
}

model H5PContent {
  id             String           @id @map("Id") @db.Char(36)
  organizationId String           @map("OrganizationId") @db.Char(36)
  createdById    String?          @map("CreatedById") @db.Char(36)
  title          String           @map("Title") @db.VarChar(200)
  library        String           @map("Library") @db.VarChar(100)
  contentType    String           @map("ContentType") @db.VarChar(40)
  parameters     String           @map("Parameters") @db.LongText
  draft          String?          @map("Draft") @db.LongText
  maxScore       Int              @default(0) @map("MaxScore")
  status         H5PContentStatus @default(DRAFT) @map("Status")
  source         H5PContentSource @default(MANUAL) @map("Source")
  subject        String?          @map("Subject") @db.VarChar(100)
  gradeLevel     String?          @map("GradeLevel") @db.VarChar(10)
  topic          String?          @map("Topic") @db.VarChar(200)
  difficulty     String?          @map("Difficulty") @db.VarChar(20)
  courseId       String?          @map("CourseId") @db.Char(36)
  lessonId       String?          @map("LessonId") @db.Char(36)
  aiModel        String?          @map("AiModel") @db.VarChar(100)
  promptVersion  String?          @map("PromptVersion") @db.VarChar(60)
  aiJobId        String?          @map("AiJobId") @db.Char(36)
  createdAt      DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime?        @map("DeletedAt") @db.DateTime(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments  Assignment[]
  results      H5PContentResult[]

  @@index([organizationId, status, deletedAt])
  @@map("H5PContents")
}

model H5PContentResult {
  id               String   @id @map("Id") @db.Char(36)
  contentId        String   @map("ContentId") @db.Char(36)
  userId           String   @map("UserId") @db.Char(36)
  studentId        String?  @map("StudentId") @db.Char(36)
  assignmentId     String?  @map("AssignmentId") @db.Char(36)
  score            Decimal  @map("Score") @db.Decimal(7, 2)
  maxScore         Decimal  @map("MaxScore") @db.Decimal(7, 2)
  completed        Boolean  @default(true) @map("Completed")
  timeSpentSeconds Int?     @map("TimeSpentSeconds")
  detail           String?  @map("Detail") @db.Text
  createdAt        DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  content    H5PContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([contentId, userId, createdAt])
  @@index([assignmentId, studentId])
  @@map("H5PContentResults")
}

model AiJob {
  id              String      @id @map("Id") @db.Char(36)
  organizationId  String?     @map("OrganizationId") @db.Char(36)
  userId          String      @map("UserId") @db.Char(36)
  capability      String      @map("Capability") @db.VarChar(50)
  status          AiJobStatus @default(QUEUED) @map("Status")
  aiJobId         String?     @map("AiJobId") @db.VarChar(64)
  traceId         String      @map("TraceId") @db.Char(36)
  request         String      @map("Request") @db.Text
  progress        String?     @map("Progress") @db.VarChar(200)
  resultContentId String?     @map("ResultContentId") @db.Char(36)
  errorCode       String?     @map("ErrorCode") @db.VarChar(60)
  errorDetail     String?     @map("ErrorDetail") @db.Text
  createdAt       DateTime    @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt       DateTime    @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("AiJobs")
}

// ---------------------------------------------------------------------------
// Communication: announcements, notifications, messaging. Release 1 slice 7.
// ---------------------------------------------------------------------------

model Announcement {
  id             String               @id @map("Id") @db.Char(36)
  organizationId String               @map("OrganizationId") @db.Char(36)
  classId        String?              @map("ClassId") @db.Char(36)
  authorId       String?              @map("AuthorId") @db.Char(36)
  title          String               @map("Title") @db.VarChar(200)
  content        String               @map("Content") @db.Text
  type           AnnouncementType     @default(GENERAL) @map("Type")
  priority       AnnouncementPriority @default(NORMAL) @map("Priority")
  status         AnnouncementStatus   @default(DRAFT) @map("Status")
  pinned         Boolean              @default(false) @map("Pinned")
  publishedAt    DateTime?            @map("PublishedAt") @db.DateTime(6)
  expiresAt      DateTime?            @map("ExpiresAt") @db.DateTime(6)
  createdAt      DateTime             @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime             @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime?            @map("DeletedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, publishedAt])
  @@index([classId, status])
  @@map("Announcements")
}

model Notification {
  id          String               @id @map("Id") @db.Char(36)
  recipientId String               @map("RecipientId") @db.Char(36)
  category    NotificationCategory @map("Category")
  title       String               @map("Title") @db.VarChar(200)
  body        String?              @map("Body") @db.Text
  link        String?              @map("Link") @db.VarChar(500)
  entityType  String?              @map("EntityType") @db.VarChar(60)
  entityId    String?              @map("EntityId") @db.Char(36)
  isRead      Boolean              @default(false) @map("IsRead")
  readAt      DateTime?            @map("ReadAt") @db.DateTime(6)
  createdAt   DateTime             @default(now()) @map("CreatedAt") @db.DateTime(6)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@map("Notifications")
}

model NotificationPreference {
  id        String               @id @map("Id") @db.Char(36)
  userId    String               @map("UserId") @db.Char(36)
  category  NotificationCategory @map("Category")
  inApp     Boolean              @default(true) @map("InApp")
  email     Boolean              @default(false) @map("Email")
  updatedAt DateTime             @updatedAt @map("UpdatedAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("NotificationPreferences")
}

model Conversation {
  id             String           @id @map("Id") @db.Char(36)
  organizationId String?          @map("OrganizationId") @db.Char(36)
  type           ConversationType @default(DIRECT) @map("Type")
  classId        String?          @map("ClassId") @db.Char(36)
  title          String?          @map("Title") @db.VarChar(200)
  createdById    String?          @map("CreatedById") @db.Char(36)
  lastMessageAt  DateTime?        @map("LastMessageAt") @db.DateTime(6)
  createdAt      DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  class        Class?                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId, lastMessageAt])
  @@index([classId])
  @@map("Conversations")
}

model ConversationParticipant {
  id             String    @id @map("Id") @db.Char(36)
  conversationId String    @map("ConversationId") @db.Char(36)
  userId         String    @map("UserId") @db.Char(36)
  joinedAt       DateTime  @default(now()) @map("JoinedAt") @db.DateTime(6)
  leftAt         DateTime? @map("LeftAt") @db.DateTime(6)
  lastReadAt     DateTime? @map("LastReadAt") @db.DateTime(6)
  muted          Boolean   @default(false) @map("Muted")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("ConversationParticipants")
}

model Message {
  id               String    @id @map("Id") @db.Char(36)
  conversationId   String    @map("ConversationId") @db.Char(36)
  senderId         String?   @map("SenderId") @db.Char(36)
  content          String    @map("Content") @db.Text
  replyToMessageId String?   @map("ReplyToMessageId") @db.Char(36)
  editedAt         DateTime? @map("EditedAt") @db.DateTime(6)
  deletedAt        DateTime? @map("DeletedAt") @db.DateTime(6)
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?      @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("MessageReplies")
  files        MessageFile[]

  @@index([conversationId, createdAt])
  @@map("Messages")
}

model MessageFile {
  id        String @id @map("Id") @db.Char(36)
  messageId String @map("MessageId") @db.Char(36)
  fileId    String @map("FileId") @db.Char(36)

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    FileUpload @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@map("MessageFiles")
}

// ---------------------------------------------------------------------------
// Rostering and sign-in (docs/13 section 2, ADR-025). Release 2 slice 9.
// ---------------------------------------------------------------------------

model UserIdentity {
  id       String           @id @map("Id") @db.Char(36)
  userId   String           @map("UserId") @db.Char(36)
  provider IdentityProvider @map("Provider")
  subject  String           @map("Subject") @db.VarChar(255)
  email    String?          @map("Email") @db.VarChar(256)
  linkedAt DateTime         @default(now()) @map("LinkedAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("UserIdentities")
}

model RosterSource {
  id             String         @id @map("Id") @db.Char(36)
  organizationId String         @map("OrganizationId") @db.Char(36)
  provider       RosterProvider @map("Provider")
  name           String         @map("Name") @db.VarChar(120)
  config         String         @map("Config") @db.Text
  isEnabled      Boolean        @default(true) @map("IsEnabled")
  lastRunAt      DateTime?      @map("LastRunAt") @db.DateTime(6)
  createdAt      DateTime       @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime       @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         RosterSyncRun[]

  @@index([organizationId])
  @@map("RosterSources")
}

model RosterSyncRun {
  id             String          @id @map("Id") @db.Char(36)
  sourceId       String?         @map("SourceId") @db.Char(36)
  organizationId String          @map("OrganizationId") @db.Char(36)
  provider       RosterProvider  @map("Provider")
  status         RosterRunStatus @default(QUEUED) @map("Status")
  dryRun         Boolean         @default(false) @map("DryRun")
  triggeredById  String?         @map("TriggeredById") @db.Char(36)
  startedAt      DateTime        @default(now()) @map("StartedAt") @db.DateTime(6)
  finishedAt     DateTime?       @map("FinishedAt") @db.DateTime(6)
  summary        String?         @map("Summary") @db.Text
  errorMessage   String?         @map("ErrorMessage") @db.Text

  source      RosterSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  triggeredBy User?             @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  errors      RosterSyncError[]

  @@index([organizationId, startedAt])
  @@map("RosterSyncRuns")
}

model RosterSyncError {
  id         String  @id @map("Id") @db.Char(36)
  runId      String  @map("RunId") @db.Char(36)
  entityType String  @map("EntityType") @db.VarChar(40)
  externalId String? @map("ExternalId") @db.VarChar(128)
  message    String  @map("Message") @db.VarChar(500)

  run RosterSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("RosterSyncErrors")
}

// ---------------------------------------------------------------------------
// School structure and calendar (docs/13 sections 3 and 5). Release 2 slice 10.
// ---------------------------------------------------------------------------

model AcademicYear {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String   @map("OrganizationId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(50)
  startDate      DateTime @map("StartDate") @db.Date
  endDate        DateTime @map("EndDate") @db.Date
  isCurrent      Boolean  @default(false) @map("IsCurrent")
  externalId     String?  @map("ExternalId") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms        Term[]
  classes      Class[]

  @@unique([organizationId, name])
  @@map("AcademicYears")
}

model Term {
  id             String   @id @map("Id") @db.Char(36)
  academicYearId String   @map("AcademicYearId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(50)
  type           TermType @default(SEMESTER) @map("Type")
  startDate      DateTime @map("StartDate") @db.Date
  endDate        DateTime @map("EndDate") @db.Date
  sortOrder      Int      @default(0) @map("SortOrder")
  externalId     String?  @map("ExternalId") @db.VarChar(128)

  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradingPeriods GradingPeriod[]
  classes        Class[]

  @@unique([academicYearId, name])
  @@map("Terms")
}

model GradingPeriod {
  id        String   @id @map("Id") @db.Char(36)
  termId    String   @map("TermId") @db.Char(36)
  name      String   @map("Name") @db.VarChar(50)
  startDate DateTime @map("StartDate") @db.Date
  endDate   DateTime @map("EndDate") @db.Date
  sortOrder Int      @default(0) @map("SortOrder")

  term        Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  reportCards ReportCard[]

  @@unique([termId, name])
  @@map("GradingPeriods")
}

model BellSchedule {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String   @map("OrganizationId") @db.Char(36)
  name           String   @map("Name") @db.VarChar(80)
  isDefault      Boolean  @default(false) @map("IsDefault")
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      Period[]

  @@unique([organizationId, name])
  @@map("BellSchedules")
}

model Period {
  id             String @id @map("Id") @db.Char(36)
  bellScheduleId String @map("BellScheduleId") @db.Char(36)
  name           String @map("Name") @db.VarChar(20)
  startTime      String @map("StartTime") @db.VarChar(5)
  endTime        String @map("EndTime") @db.VarChar(5)
  days           String @default("MTWRF") @map("Days") @db.VarChar(7)
  sortOrder      Int    @default(0) @map("SortOrder")

  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)
  classes      Class[]
  attendance   Attendance[]

  @@unique([bellScheduleId, name])
  @@map("Periods")
}

model AttendanceCode {
  id              String             @id @map("Id") @db.Char(36)
  organizationId  String             @map("OrganizationId") @db.Char(36)
  code            String             @map("Code") @db.VarChar(10)
  label           String             @map("Label") @db.VarChar(60)
  category        AttendanceCategory @map("Category")
  countsAsPresent Boolean            @default(false) @map("CountsAsPresent")
  isActive        Boolean            @default(true) @map("IsActive")
  sortOrder       Int                @default(0) @map("SortOrder")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendance   Attendance[]

  @@unique([organizationId, code])
  @@map("AttendanceCodes")
}

model CalendarEvent {
  id             String            @id @map("Id") @db.Char(36)
  organizationId String            @map("OrganizationId") @db.Char(36)
  classId        String?           @map("ClassId") @db.Char(36)
  type           CalendarEventType @default(SCHOOL_EVENT) @map("Type")
  title          String            @map("Title") @db.VarChar(200)
  description    String?           @map("Description") @db.Text
  startsAt       DateTime          @map("StartsAt") @db.DateTime(6)
  endsAt         DateTime?         @map("EndsAt") @db.DateTime(6)
  allDay         Boolean           @default(true) @map("AllDay")
  createdById    String?           @map("CreatedById") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime          @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([classId, startsAt])
  @@map("CalendarEvents")
}

// ---------------------------------------------------------------------------
// Feature permissions and flags (docs/02 section 2)
// ---------------------------------------------------------------------------

model Feature {
  id          String   @id @map("Id") @db.Char(36)
  code        String   @unique @map("Code") @db.VarChar(100)
  name        String   @map("Name") @db.VarChar(200)
  description String?  @map("Description") @db.Text
  category    String   @map("Category") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("IsActive")
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  roleFeatures RoleFeature[]
  overrides    UserFeatureOverride[]

  @@index([category])
  @@map("Features")
}

model RoleFeature {
  id         String   @id @map("Id") @db.Char(36)
  role       Role     @map("Role")
  featureId  String   @map("FeatureId") @db.Char(36)
  assignedBy String?  @map("AssignedBy") @db.Char(36)
  assignedAt DateTime @default(now()) @map("AssignedAt") @db.DateTime(6)

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([role, featureId])
  @@index([featureId])
  @@map("RoleFeatures")
}

model UserFeatureOverride {
  id         String    @id @map("Id") @db.Char(36)
  userId     String    @map("UserId") @db.Char(36)
  featureId  String    @map("FeatureId") @db.Char(36)
  isGranted  Boolean   @map("IsGranted")
  reason     String?   @map("Reason") @db.Text
  assignedBy String?   @map("AssignedBy") @db.Char(36)
  expiresAt  DateTime? @map("ExpiresAt") @db.DateTime(6)
  createdAt  DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([featureId])
  @@map("UserFeatureOverrides")
}

model FeatureFlag {
  id          String   @id @map("Id") @db.Char(36)
  name        String   @unique @map("Name") @db.VarChar(100)
  isEnabled   Boolean  @default(false) @map("IsEnabled")
  description String?  @map("Description") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  @@map("FeatureFlags")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @map("Id") @db.Char(36)
  userId         String?  @map("UserId") @db.Char(36)
  organizationId String?  @map("OrganizationId") @db.Char(36)
  action         String   @map("Action") @db.VarChar(100)
  entityType     String?  @map("EntityType") @db.VarChar(100)
  entityId       String?  @map("EntityId") @db.VarChar(100)
  ipAddress      String?  @map("IpAddress") @db.VarChar(45)
  userAgent      String?  @map("UserAgent") @db.VarChar(500)
  requestPath    String?  @map("RequestPath") @db.VarChar(500)
  httpMethod     String?  @map("HttpMethod") @db.VarChar(10)
  statusCode     Int?     @map("StatusCode")
  details        String?  @map("Details") @db.Text // JSON document
  traceId        String?  @map("TraceId") @db.VarChar(64)
  timestamp      DateTime @default(now()) @map("Timestamp") @db.DateTime(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
  @@index([action, timestamp])
  @@index([entityType, entityId])
  @@map("AuditLogs")
}

// ---------------------------------------------------------------------------
// Platform (ADR-007)
// ---------------------------------------------------------------------------

model JobRun {
  jobName    String    @id @map("JobName") @db.VarChar(100)
  lockedAt   DateTime? @map("LockedAt") @db.DateTime(6)
  lockedBy   String?   @map("LockedBy") @db.VarChar(100)
  lastRunAt  DateTime? @map("LastRunAt") @db.DateTime(6)
  lastStatus String?   @map("LastStatus") @db.VarChar(20)
  lastError  String?   @map("LastError") @db.Text
  runCount   Int       @default(0) @map("RunCount")

  @@map("JobRuns")
}

/// Weighted grade categories per class (docs/13 section 4): Homework 20, Quizzes 30, Tests 50.
model GradeCategory {
  id         String  @id @map("Id") @db.Char(36)
  classId    String  @map("ClassId") @db.Char(36)
  name       String  @map("Name") @db.VarChar(60)
  weight     Decimal @default(0) @map("Weight") @db.Decimal(5, 2)
  dropLowest Int     @default(0) @map("DropLowest")
  sortOrder  Int     @default(0) @map("SortOrder")

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([classId, name])
  @@map("GradeCategories")
}

/// A teacher-set mark that overrides the derived one (Missing counts as zero; Excused is left out).
model AssignmentMark {
  id           String     @id @map("Id") @db.Char(36)
  assignmentId String     @map("AssignmentId") @db.Char(36)
  studentId    String     @map("StudentId") @db.Char(36)
  mark         MarkStatus @map("Mark")
  note         String?    @map("Note") @db.VarChar(500)
  setById      String?    @map("SetById") @db.Char(36)
  updatedAt    DateTime   @updatedAt @map("UpdatedAt") @db.DateTime(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("AssignmentMarks")
}

/// A set of academic standards (Common Core, NGSS, a state set); organisation-less sets are shared by everyone.
model StandardSet {
  id             String   @id @map("Id") @db.Char(36)
  organizationId String?  @map("OrganizationId") @db.Char(36)
  code           String   @map("Code") @db.VarChar(40)
  name           String   @map("Name") @db.VarChar(200)
  subject        String?  @map("Subject") @db.VarChar(100)
  jurisdiction   String?  @map("Jurisdiction") @db.VarChar(100)
  sourceUri      String?  @map("SourceUri") @db.VarChar(500)
  version        String?  @map("Version") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standards    Standard[]

  @@index([organizationId, code])
  @@map("StandardSets")
}

model Standard {
  id          String  @id @map("Id") @db.Char(36)
  setId       String  @map("SetId") @db.Char(36)
  parentId    String? @map("ParentId") @db.Char(36)
  code        String  @map("Code") @db.VarChar(80)
  description String  @map("Description") @db.Text
  gradeLevels String? @map("GradeLevels") @db.VarChar(100)
  sortOrder   Int     @default(0) @map("SortOrder")

  set         StandardSet          @relation(fields: [setId], references: [id], onDelete: Cascade)
  parent      Standard?            @relation("StandardTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Standard[]           @relation("StandardTree")
  assignments AssignmentStandard[]
  lessons     LessonStandard[]
  scores      StandardScore[]

  @@unique([setId, code])
  @@index([setId, gradeLevels])
  @@map("Standards")
}

model AssignmentStandard {
  assignmentId String @map("AssignmentId") @db.Char(36)
  standardId   String @map("StandardId") @db.Char(36)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  standard   Standard   @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([assignmentId, standardId])
  @@map("AssignmentStandards")
}

model LessonStandard {
  lessonId   String @map("LessonId") @db.Char(36)
  standardId String @map("StandardId") @db.Char(36)

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([lessonId, standardId])
  @@map("LessonStandards")
}

/// Levels for standards-based grading, e.g. Beginning 1, Developing 2, Proficient 3, Advanced 4 (JSON in Levels).
model ProficiencyScale {
  id             String  @id @map("Id") @db.Char(36)
  organizationId String  @map("OrganizationId") @db.Char(36)
  name           String  @map("Name") @db.VarChar(80)
  levels         String  @map("Levels") @db.Text
  isDefault      Boolean @default(false) @map("IsDefault")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classes      Class[]

  @@unique([organizationId, name])
  @@map("ProficiencyScales")
}

/// The level a student reached on one standard in one graded assignment.
model StandardScore {
  id         String @id @map("Id") @db.Char(36)
  gradeId    String @map("GradeId") @db.Char(36)
  standardId String @map("StandardId") @db.Char(36)
  level      Int    @map("Level")
  label      String @map("Label") @db.VarChar(40)

  grade    Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([gradeId, standardId])
  @@map("StandardScores")
}

/// A report card or progress report for one student and grading period: a snapshot, with teacher comments.
model ReportCard {
  id              String           @id @map("Id") @db.Char(36)
  organizationId  String           @map("OrganizationId") @db.Char(36)
  studentId       String           @map("StudentId") @db.Char(36)
  gradingPeriodId String           @map("GradingPeriodId") @db.Char(36)
  kind            ReportCardKind   @default(REPORT_CARD) @map("Kind")
  status          ReportCardStatus @default(DRAFT) @map("Status")
  gpa             Decimal?         @map("GPA") @db.Decimal(4, 2)
  attendance      String?          @map("Attendance") @db.Text
  generatedById   String?          @map("GeneratedById") @db.Char(36)
  publishedAt     DateTime?        @map("PublishedAt") @db.DateTime(6)
  createdAt       DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt       DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradingPeriod GradingPeriod    @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)
  lines         ReportCardLine[]

  @@unique([studentId, gradingPeriodId, kind])
  @@index([organizationId, gradingPeriodId, status])
  @@map("ReportCards")
}

model ReportCardLine {
  id           String   @id @map("Id") @db.Char(36)
  reportCardId String   @map("ReportCardId") @db.Char(36)
  classId      String   @map("ClassId") @db.Char(36)
  className    String   @map("ClassName") @db.VarChar(200)
  courseTitle  String   @map("CourseTitle") @db.VarChar(200)
  teacherName  String?  @map("TeacherName") @db.VarChar(200)
  percentage   Decimal? @map("Percentage") @db.Decimal(5, 2)
  letter       String?  @map("Letter") @db.VarChar(4)
  gpaPoints    Decimal? @map("GpaPoints") @db.Decimal(4, 2)
  categories   String?  @map("Categories") @db.Text
  standards    String?  @map("Standards") @db.Text
  comment      String?  @map("Comment") @db.Text
  commentById  String?  @map("CommentById") @db.Char(36)
  updatedAt    DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([reportCardId, classId])
  @@map("ReportCardLines")
}
