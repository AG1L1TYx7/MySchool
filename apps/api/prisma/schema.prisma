  description        String?          @map("Description") @db.Text
  instructions       String?          @map("Instructions") @db.Text
  type               AssignmentType   @default(HOMEWORK) @map("Type")
  submissionType     SubmissionType   @default(ONLINE) @map("SubmissionType")
  category           String?          @map("Category") @db.VarChar(50)
  categoryId         String?          @map("CategoryId") @db.Char(36)
  isExtraCredit      Boolean          @default(false) @map("IsExtraCredit")
  gradingPeriodId    String?          @map("GradingPeriodId") @db.Char(36)
  maxPoints          Decimal          @default(100) @map("MaxPoints") @db.Decimal(7, 2)
  weight             Decimal          @default(1) @map("Weight") @db.Decimal(5, 2)
  availableFrom      DateTime?        @map("AvailableFrom") @db.DateTime(6)
  dueAt              DateTime?        @map("DueAt") @db.DateTime(6)
  allowLateUntil     DateTime?        @map("AllowLateUntil") @db.DateTime(6)
