// SmartSchool LMS schema (docs/03-DATA-MODEL.md).
//
// Conventions (ADR-003, ADR-020): PascalCase table and column names in the database,
// camelCase fields in Prisma via @map, application-generated UUID v7 keys stored as
// char(36), UTC datetime(6), soft delete via DeletedAt where listed in docs/03 section 4.
// The 12 AI-owned tables (added in Release 1 slice 5 and Release 2) keep the exact
// names and columns the Python service expects.
//
// Release 1 slice 1: identity and access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (stored as MySQL ENUM on tables this API owns)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  SUPERINTENDENT
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ASSISTANT
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

enum LearningStyle {
  VISUAL
  AUDITORY
  KINESTHETIC
  READING_WRITING
  MIXED
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// ---------------------------------------------------------------------------
// Organisation (school-level container; tenancy arrives in Release 3, ADR-019)
// ---------------------------------------------------------------------------

model Organization {
  id          String    @id @map("Id") @db.Char(36)
  name        String    @map("Name") @db.VarChar(200)
  description String?   @map("Description") @db.VarChar(500)
  email       String?   @map("Email") @db.VarChar(100)
  phone       String?   @map("Phone") @db.VarChar(20)
  address     String?   @map("Address") @db.VarChar(500)
  timezone    String    @default("UTC") @map("Timezone") @db.VarChar(64)
  isActive    Boolean   @default(true) @map("IsActive")
  createdAt   DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt   DateTime? @map("DeletedAt") @db.DateTime(6)

  users    User[]
  students Student[]

  @@index([name])
  @@index([isActive, deletedAt])
  @@map("Organizations")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String     @id @map("Id") @db.Char(36)
  email             String     @unique @map("Email") @db.VarChar(256)
  emailVerifiedAt   DateTime?  @map("EmailVerifiedAt") @db.DateTime(6)
  passwordHash      String     @map("PasswordHash") @db.VarChar(512)
  passwordChangedAt DateTime?  @map("PasswordChangedAt") @db.DateTime(6)
  firstName         String     @map("FirstName") @db.VarChar(100)
  lastName          String     @map("LastName") @db.VarChar(100)
  role              Role       @map("Role")
  status            UserStatus @default(ACTIVE) @map("Status")
  organizationId    String?    @map("OrganizationId") @db.Char(36)
  phone             String?    @map("Phone") @db.VarChar(32)
  locale            String     @default("en") @map("Locale") @db.VarChar(16)
  timezone          String?    @map("Timezone") @db.VarChar(64)
  avatarFileId      String?    @map("AvatarFileId") @db.Char(36)

  twoFactorEnabled Boolean @default(false) @map("TwoFactorEnabled")
  twoFactorSecret  String? @map("TwoFactorSecret") @db.VarChar(512) // AES-256-GCM encrypted
  backupCodes      String? @map("BackupCodes") @db.Text // JSON array of argon2 hashes (TEXT: MariaDB 10.4 has no native JSON, ADR-002)

  failedLoginCount Int       @default(0) @map("FailedLoginCount")
  lockedUntil      DateTime? @map("LockedUntil") @db.DateTime(6)
  lastLoginAt      DateTime? @map("LastLoginAt") @db.DateTime(6)

  createdAt DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt DateTime? @map("DeletedAt") @db.DateTime(6)

  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  featureOverrides    UserFeatureOverride[]
  auditLogs           AuditLog[]
  student             Student?
  guardianLinks       StudentGuardian[]

  @@index([organizationId, role])
  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@map("Users")
}

/// One row per refresh token. Rotation replaces the row; reuse of a replaced token revokes the family.
model AuthSession {
  id               String    @id @map("Id") @db.Char(36)
  userId           String    @map("UserId") @db.Char(36)
  familyId         String    @map("FamilyId") @db.Char(36)
  refreshTokenHash String    @unique @map("RefreshTokenHash") @db.Char(64)
  userAgent        String?   @map("UserAgent") @db.VarChar(500)
  ipAddress        String?   @map("IpAddress") @db.VarChar(45)
  rememberMe       Boolean   @default(false) @map("RememberMe")
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  lastUsedAt       DateTime  @default(now()) @map("LastUsedAt") @db.DateTime(6)
  expiresAt        DateTime  @map("ExpiresAt") @db.DateTime(6)
  revokedAt        DateTime? @map("RevokedAt") @db.DateTime(6)
  replacedById     String?   @map("ReplacedById") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("AuthSessions")
}

model PasswordResetToken {
  id        String    @id @map("Id") @db.Char(36)
  userId    String    @map("UserId") @db.Char(36)
  tokenHash String    @unique @map("TokenHash") @db.Char(64)
  expiresAt DateTime  @map("ExpiresAt") @db.DateTime(6)
  usedAt    DateTime? @map("UsedAt") @db.DateTime(6)
  createdAt DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PasswordResetTokens")
}

// ---------------------------------------------------------------------------
// Students and guardians (docs/02 section 3). Release 1 slice 2.
// ---------------------------------------------------------------------------

model Student {
  id                     String           @id @map("Id") @db.Char(36)
  organizationId         String           @map("OrganizationId") @db.Char(36)
  userId                 String?          @unique @map("UserId") @db.Char(36)
  studentNumber          String           @map("StudentNumber") @db.VarChar(50)
  firstName              String           @map("FirstName") @db.VarChar(100)
  lastName               String           @map("LastName") @db.VarChar(100)
  email                  String?          @map("Email") @db.VarChar(256)
  phone                  String?          @map("Phone") @db.VarChar(32)
  dateOfBirth            DateTime?        @map("DateOfBirth") @db.Date
  gender                 String?          @map("Gender") @db.VarChar(32)
  gradeLevel             String?          @map("GradeLevel") @db.VarChar(16)
  enrollmentStatus       EnrollmentStatus @default(ACTIVE) @map("EnrollmentStatus")
  enrollmentDate         DateTime?        @map("EnrollmentDate") @db.Date
  preferredLearningStyle LearningStyle?   @map("PreferredLearningStyle")
  accessibilityNeeds     String?          @map("AccessibilityNeeds") @db.Text
  goals                  String?          @map("Goals") @db.Text
  notes                  String?          @map("Notes") @db.Text
  address                String?          @map("Address") @db.VarChar(500)
  gpa                    Decimal?         @map("GPA") @db.Decimal(4, 2)
  attendanceRate         Decimal?         @map("AttendanceRate") @db.Decimal(5, 2)
  createdAt              DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt              DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt              DateTime?        @map("DeletedAt") @db.DateTime(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians    StudentGuardian[]

  @@unique([organizationId, studentNumber])
  @@index([organizationId, enrollmentStatus, deletedAt])
  @@index([organizationId, gradeLevel])
  @@index([lastName, firstName])
  @@map("Students")
}

model StudentGuardian {
  id                    String               @id @map("Id") @db.Char(36)
  studentId             String               @map("StudentId") @db.Char(36)
  guardianUserId        String               @map("GuardianUserId") @db.Char(36)
  relationship          GuardianRelationship @default(GUARDIAN) @map("Relationship")
  isPrimary             Boolean              @default(false) @map("IsPrimary")
  receivesNotifications Boolean              @default(true) @map("ReceivesNotifications")
  canViewGrades         Boolean              @default(true) @map("CanViewGrades")
  canViewAttendance     Boolean              @default(true) @map("CanViewAttendance")
  createdAt             DateTime             @default(now()) @map("CreatedAt") @db.DateTime(6)

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian User    @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianUserId])
  @@index([guardianUserId])
  @@map("StudentGuardians")
}

// ---------------------------------------------------------------------------
// Feature permissions and flags (docs/02 section 2)
// ---------------------------------------------------------------------------

model Feature {
  id          String   @id @map("Id") @db.Char(36)
  code        String   @unique @map("Code") @db.VarChar(100)
  name        String   @map("Name") @db.VarChar(200)
  description String?  @map("Description") @db.Text
  category    String   @map("Category") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("IsActive")
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  roleFeatures RoleFeature[]
  overrides    UserFeatureOverride[]

  @@index([category])
  @@map("Features")
}

model RoleFeature {
  id         String   @id @map("Id") @db.Char(36)
  role       Role     @map("Role")
  featureId  String   @map("FeatureId") @db.Char(36)
  assignedBy String?  @map("AssignedBy") @db.Char(36)
  assignedAt DateTime @default(now()) @map("AssignedAt") @db.DateTime(6)

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([role, featureId])
  @@index([featureId])
  @@map("RoleFeatures")
}

model UserFeatureOverride {
  id         String    @id @map("Id") @db.Char(36)
  userId     String    @map("UserId") @db.Char(36)
  featureId  String    @map("FeatureId") @db.Char(36)
  isGranted  Boolean   @map("IsGranted")
  reason     String?   @map("Reason") @db.Text
  assignedBy String?   @map("AssignedBy") @db.Char(36)
  expiresAt  DateTime? @map("ExpiresAt") @db.DateTime(6)
  createdAt  DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([featureId])
  @@map("UserFeatureOverrides")
}

model FeatureFlag {
  id          String   @id @map("Id") @db.Char(36)
  name        String   @unique @map("Name") @db.VarChar(100)
  isEnabled   Boolean  @default(false) @map("IsEnabled")
  description String?  @map("Description") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  @@map("FeatureFlags")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @map("Id") @db.Char(36)
  userId         String?  @map("UserId") @db.Char(36)
  organizationId String?  @map("OrganizationId") @db.Char(36)
  action         String   @map("Action") @db.VarChar(100)
  entityType     String?  @map("EntityType") @db.VarChar(100)
  entityId       String?  @map("EntityId") @db.VarChar(100)
  ipAddress      String?  @map("IpAddress") @db.VarChar(45)
  userAgent      String?  @map("UserAgent") @db.VarChar(500)
  requestPath    String?  @map("RequestPath") @db.VarChar(500)
  httpMethod     String?  @map("HttpMethod") @db.VarChar(10)
  statusCode     Int?     @map("StatusCode")
  details        String?  @map("Details") @db.Text // JSON document
  traceId        String?  @map("TraceId") @db.VarChar(64)
  timestamp      DateTime @default(now()) @map("Timestamp") @db.DateTime(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
  @@index([action, timestamp])
  @@index([entityType, entityId])
  @@map("AuditLogs")
}

// ---------------------------------------------------------------------------
// Platform (ADR-007)
// ---------------------------------------------------------------------------

model JobRun {
  jobName    String    @id @map("JobName") @db.VarChar(100)
  lockedAt   DateTime? @map("LockedAt") @db.DateTime(6)
  lockedBy   String?   @map("LockedBy") @db.VarChar(100)
  lastRunAt  DateTime? @map("LastRunAt") @db.DateTime(6)
  lastStatus String?   @map("LastStatus") @db.VarChar(20)
  lastError  String?   @map("LastError") @db.Text
  runCount   Int       @default(0) @map("RunCount")

  @@map("JobRuns")
}
