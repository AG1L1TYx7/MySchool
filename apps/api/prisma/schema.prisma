// ---------------------------------------------------------------------------
// Organisation (school-level container; tenancy arrives in Release 3, ADR-019)
// ---------------------------------------------------------------------------

model Organization {
  id                     String    @id @map("Id") @db.Char(36)
  name                   String    @map("Name") @db.VarChar(200)
  description            String?   @map("Description") @db.VarChar(500)
  email                  String?   @map("Email") @db.VarChar(100)
  phone                  String?   @map("Phone") @db.VarChar(20)
  address                String?   @map("Address") @db.VarChar(500)
  timezone               String    @default("UTC") @map("Timezone") @db.VarChar(64)
  isActive               Boolean   @default(true) @map("IsActive")
  joinCode               String?   @unique @map("JoinCode") @db.VarChar(16)
  joinCodeRotatedAt      DateTime? @map("JoinCodeRotatedAt") @db.DateTime(6)
  externalId             String?   @map("ExternalId") @db.VarChar(128)
  ssoProviders           String?   @map("SsoProviders") @db.VarChar(200)
  ssoAllowedDomains      String?   @map("SsoAllowedDomains") @db.VarChar(500)
  ssoPasswordOptional    Boolean   @default(false) @map("SsoPasswordOptional")
  gradeLevels            String?   @map("GradeLevels") @db.VarChar(100)
  attendanceDeadlineTime String?   @map("AttendanceDeadlineTime") @db.VarChar(5)
  gradingScale           String?   @map("GradingScale") @db.Text
  gpaScale               String?   @map("GpaScale") @db.Text
  behaviorVisibility     String    @default("POSITIVE_ONLY") @map("BehaviorVisibility") @db.VarChar(20)
  aiConsentDefault       String    @default("SCHOOL") @map("AiConsentDefault") @db.VarChar(20)
  studentMessaging       Boolean   @default(false) @map("StudentMessaging")
  motivationEnabled      Boolean   @default(true) @map("MotivationEnabled")
  retentionPolicy        String?   @map("RetentionPolicy") @db.Text
  tenantId               String    @map("TenantId") @db.Char(36)
  createdAt              DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt              DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt              DateTime? @map("DeletedAt") @db.DateTime(6)

  users             User[]
  students          Student[]
  courses           Course[]
  classes           Class[]
  files             FileUpload[]
  rubrics           Rubric[]
  assignments       Assignment[]
  aiConversations   AiConversation[]
  h5pContents       H5PContent[]
  standardSets      StandardSet[]
  proficiencyScales ProficiencyScale[]
  reportCards       ReportCard[]
  accommodations    Accommodation[]
  wellnessAlerts    WellnessAlert[]
  behaviorRecords   BehaviorRecord[]
  aiConsents        AiConsent[]
  aiJobs            AiJob[]
  announcements     Announcement[]
  conversations     Conversation[]
  rosterSources     RosterSource[]
  academicYears     AcademicYear[]
  bellSchedules     BellSchedule[]
  attendanceCodes   AttendanceCode[]
  calendarEvents    CalendarEvent[]

  badges Badge[]
  quests Quest[]

  lessonPlans   LessonPlan[]
  teacherDrafts TeacherDraft[]

  xapiStatements       XapiStatement[]
  reportSchedules      ReportSchedule[]
  reportRuns           ReportRun[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  webhookSubscriptions WebhookSubscription[]
  apiKeys              ApiKey[]
  ltiPlatforms         LtiPlatform[]
  ltiTools             LtiTool[]

  deletionRequests  DeletionRequest[]
  securityIncidents SecurityIncident[]
  srsCards          SrsCard[]

  libraryItems       LibraryItem[]
  libraryCollections LibraryCollection[]

  @@index([tenantId])
  @@index([name])
  @@index([isActive, deletedAt])
  @@map("Organizations")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String     @id @map("Id") @db.Char(36)
  email             String     @unique @map("Email") @db.VarChar(256)
  emailVerifiedAt   DateTime?  @map("EmailVerifiedAt") @db.DateTime(6)
  passwordHash      String     @map("PasswordHash") @db.VarChar(512)
  passwordChangedAt DateTime?  @map("PasswordChangedAt") @db.DateTime(6)
  firstName         String     @map("FirstName") @db.VarChar(100)
  lastName          String     @map("LastName") @db.VarChar(100)
  role              Role       @map("Role")
  status            UserStatus @default(ACTIVE) @map("Status")
  organizationId    String?    @map("OrganizationId") @db.Char(36)
  phone             String?    @map("Phone") @db.VarChar(32)
  locale            String     @default("en") @map("Locale") @db.VarChar(16)
  timezone          String?    @map("Timezone") @db.VarChar(64)
  avatarFileId      String?    @map("AvatarFileId") @db.Char(36)

  twoFactorEnabled Boolean @default(false) @map("TwoFactorEnabled")
  twoFactorSecret  String? @map("TwoFactorSecret") @db.VarChar(512) // AES-256-GCM encrypted
  backupCodes      String? @map("BackupCodes") @db.Text // JSON array of argon2 hashes (TEXT: MariaDB 10.4 has no native JSON, ADR-002)

  lastTotpStep     Int?         @map("LastTotpStep")
  failedLoginCount Int          @default(0) @map("FailedLoginCount")
  lockedUntil      DateTime?    @map("LockedUntil") @db.DateTime(6)
  lastLoginAt      DateTime?    @map("LastLoginAt") @db.DateTime(6)
  externalId       String?      @map("ExternalId") @db.VarChar(128)
  source           RecordSource @default(MANUAL) @map("Source")
  managedBySis     Boolean      @default(false) @map("ManagedBySis")

  createdAt DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt DateTime? @map("DeletedAt") @db.DateTime(6)

  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions           AuthSession[]
  authTokens         AuthToken[]
  featureOverrides   UserFeatureOverride[]
  auditLogs          AuditLog[]
  student            Student?
  guardianLinks      StudentGuardian[]
  coursesInstructed  Course[]                  @relation("CourseInstructor")
  coursesCreated     Course[]                  @relation("CourseCreator")
  classesTaught      ClassTeacher[]
  uploads            FileUpload[]
  rubricsCreated     Rubric[]
  assignmentsCreated Assignment[]
  gradesGiven        Grade[]
  attendanceMarked   Attendance[]
  aiConversations    AiConversation[]
  h5pContents        H5PContent[]
  h5pResults         H5PContentResult[]
  aiJobs             AiJob[]
  announcements      Announcement[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  conversationsMade  Conversation[]
  participations     ConversationParticipant[]
  messagesSent       Message[]
  identities         UserIdentity[]
  rosterRuns         RosterSyncRun[]
  calendarEvents     CalendarEvent[]
  caseload           CounselorCaseload[]
  counselorNotes     CounselorNote[]
  wellnessAssigned   WellnessAlert[]
  behaviorReported   BehaviorRecord[]
  conferenceNotes    ConferenceNote[]
  summariesReviewed  LessonSummary[]
  icalToken          String?                   @unique @map("IcalToken") @db.VarChar(64)

  rewardsGiven  RewardTransaction[]
  badgesGiven   StudentBadge[]
  questsCreated Quest[]

  lessonPlans        LessonPlan[]
  gradingRequests    GradingSuggestion[] @relation("GradingRequestedBy")
  gradingReviews     GradingSuggestion[] @relation("GradingReviewedBy")
  teacherDrafts      TeacherDraft[]
  classInsights      ClassInsight[]
  substituteAccess   SubstituteAccess[]  @relation("SubstituteUser")
  substitutesGranted SubstituteAccess[]  @relation("SubstituteGrantedBy")

  xapiStatements    XapiStatement[]
  reportSchedules   ReportSchedule[]
  pushDevices       PushDevice[]
  deletionRequests  DeletionRequest[]
  securityIncidents SecurityIncident[]
  pushLogs          PushLog[]

  apiKeys      ApiKey[]
  ltiUserLinks LtiUserLink[]

  libraryItems       LibraryItem[]
  libraryRatings     LibraryRating[]
  libraryFlags       LibraryFlag[]
  libraryCollections LibraryCollection[]
  libraryFollows     LibraryCollectionFollower[]

  @@index([organizationId, role])
  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@index([organizationId, externalId])
  @@map("Users")
}

/// One row per refresh token. Rotation replaces the row; reuse of a replaced token revokes the family.
model AuthSession {
  id                String    @id @map("Id") @db.Char(36)
  userId            String    @map("UserId") @db.Char(36)
  familyId          String    @map("FamilyId") @db.Char(36)
  refreshTokenHash  String    @unique @map("RefreshTokenHash") @db.Char(64)
  userAgent         String?   @map("UserAgent") @db.VarChar(500)
  ipAddress         String?   @map("IpAddress") @db.VarChar(45)
  rememberMe        Boolean   @default(false) @map("RememberMe")
  createdAt         DateTime  @default(now()) @map("CreatedAt") @db.DateTime(6)
  lastUsedAt        DateTime  @default(now()) @map("LastUsedAt") @db.DateTime(6)
  expiresAt         DateTime  @map("ExpiresAt") @db.DateTime(6)
  revokedAt         DateTime? @map("RevokedAt") @db.DateTime(6)
  replacedById      String?   @map("ReplacedById") @db.Char(36)
  absoluteExpiresAt DateTime? @map("AbsoluteExpiresAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("AuthSessions")
}

/// Single-use emailed tokens: password reset, email verification, invitations. Only the SHA-256 hash is stored.
model AuthToken {
  id        String           @id @map("Id") @db.Char(36)
  userId    String           @map("UserId") @db.Char(36)
  purpose   AuthTokenPurpose @map("Purpose")
  tokenHash String           @unique @map("TokenHash") @db.Char(64)
  expiresAt DateTime         @map("ExpiresAt") @db.DateTime(6)
  usedAt    DateTime?        @map("UsedAt") @db.DateTime(6)
  createdAt DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("AuthTokens")
}

// ---------------------------------------------------------------------------
// Students and guardians (docs/02 section 3). Release 1 slice 2.
// ---------------------------------------------------------------------------

model Student {
  id                     String           @id @map("Id") @db.Char(36)
  organizationId         String           @map("OrganizationId") @db.Char(36)
  userId                 String?          @unique @map("UserId") @db.Char(36)
  studentNumber          String           @map("StudentNumber") @db.VarChar(50)
  firstName              String           @map("FirstName") @db.VarChar(100)
  lastName               String           @map("LastName") @db.VarChar(100)
  email                  String?          @map("Email") @db.VarChar(256)
  phone                  String?          @map("Phone") @db.VarChar(32)
  dateOfBirth            DateTime?        @map("DateOfBirth") @db.Date
  gender                 String?          @map("Gender") @db.VarChar(32)
  gradeLevel             String?          @map("GradeLevel") @db.VarChar(16)
  enrollmentStatus       EnrollmentStatus @default(ACTIVE) @map("EnrollmentStatus")
  legalHold              Boolean          @default(false) @map("LegalHold")
  enrollmentDate         DateTime?        @map("EnrollmentDate") @db.Date
  preferredLearningStyle LearningStyle?   @map("PreferredLearningStyle")
  accessibilityNeeds     String?          @map("AccessibilityNeeds") @db.Text
  goals                  String?          @map("Goals") @db.Text
  notes                  String?          @map("Notes") @db.Text
  address                String?          @map("Address") @db.VarChar(500)
  gpa                    Decimal?         @map("GPA") @db.Decimal(4, 2)
  attendanceRate         Decimal?         @map("AttendanceRate") @db.Decimal(5, 2)
  externalId             String?          @map("ExternalId") @db.VarChar(128)
  source                 RecordSource     @default(MANUAL) @map("Source")
  managedBySis           Boolean          @default(false) @map("ManagedBySis")
  createdAt              DateTime         @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt              DateTime         @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt              DateTime?        @map("DeletedAt") @db.DateTime(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  marks           AssignmentMark[]
  reportCards     ReportCard[]
  accommodation   Accommodation?
  caseloads       CounselorCaseload[]
  counselorNotes  CounselorNote[]
  wellnessAlerts  WellnessAlert[]
  behaviorRecords BehaviorRecord[]
  aiConsent       AiConsent?
  conferenceNotes ConferenceNote[]
  guardians       StudentGuardian[]
  enrollments     ClassEnrollment[]
  submissions     AssignmentSubmission[]
  grades          Grade[]
  attendance      Attendance[]
  h5pResults      H5PContentResult[]

  points            StudentPoints?
  rewards           RewardTransaction[]
  badges            StudentBadge[]
  lessonCompletions LessonCompletion[]
  quests            Quest[]
  questProgress     QuestProgress[]

  gradingSuggestions GradingSuggestion[]
  teacherDrafts      TeacherDraft[]

  xapiStatements   XapiStatement[]
  srsCards         SrsCard[]
  srsReviews       SrsReview[]
  mastery          MasteryLevel[]
  deletionRequests DeletionRequest[]

  @@unique([organizationId, studentNumber])
  @@index([organizationId, enrollmentStatus, deletedAt])
  @@index([organizationId, gradeLevel])
  @@index([lastName, firstName])
  @@index([organizationId, externalId])
  @@map("Students")
}

model StudentGuardian {
  id                    String               @id @map("Id") @db.Char(36)
  studentId             String               @map("StudentId") @db.Char(36)
  guardianUserId        String               @map("GuardianUserId") @db.Char(36)
  relationship          GuardianRelationship @default(GUARDIAN) @map("Relationship")
  isPrimary             Boolean              @default(false) @map("IsPrimary")
  source                RecordSource         @default(MANUAL) @map("Source")
  receivesNotifications Boolean              @default(true) @map("ReceivesNotifications")
  canViewGrades         Boolean              @default(true) @map("CanViewGrades")
  canViewAttendance     Boolean              @default(true) @map("CanViewAttendance")
  createdAt             DateTime             @default(now()) @map("CreatedAt") @db.DateTime(6)

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian User    @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianUserId])
  @@index([guardianUserId])
  @@map("StudentGuardians")
}

// ---------------------------------------------------------------------------
// Curriculum and classes (docs/02 sections 4 and 5). Release 1 slice 3.
// ---------------------------------------------------------------------------

model Course {
  id             String       @id @map("Id") @db.Char(36)
  organizationId String       @map("OrganizationId") @db.Char(36)
  courseCode     String       @map("CourseCode") @db.VarChar(50)
  title          String       @map("Title") @db.VarChar(200)
  description    String?      @map("Description") @db.Text
  subject        String?      @map("Subject") @db.VarChar(100)
  gradeLevel     String?      @map("GradeLevel") @db.VarChar(16)
  creditHours    Decimal?     @map("CreditHours") @db.Decimal(4, 2)
  estimatedHours Int?         @map("EstimatedHours")
  status         CourseStatus @default(DRAFT) @map("Status")
  isPublished    Boolean      @default(false) @map("IsPublished")
  externalId     String?      @map("ExternalId") @db.VarChar(128)
  source         RecordSource @default(MANUAL) @map("Source")
  publishedAt    DateTime?    @map("PublishedAt") @db.DateTime(6)
  instructorId   String?      @map("InstructorId") @db.Char(36)
  createdById    String?      @map("CreatedById") @db.Char(36)
  clonedFromId   String?      @map("ClonedFromId") @db.Char(36)
  createdAt      DateTime     @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt      DateTime     @updatedAt @map("UpdatedAt") @db.DateTime(6)
  deletedAt      DateTime?    @map("DeletedAt") @db.DateTime(6)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor    User?                @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules       Module[]
  classes       Class[]
  prerequisites CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredBy    CoursePrerequisite[] @relation("CourseRequiredBy")

  lessonPlans LessonPlan[]

  @@unique([organizationId, courseCode])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, subject, gradeLevel])
  @@index([instructorId])
  @@map("Courses")
}

model CoursePrerequisite {
  id                   String @id @map("Id") @db.Char(36)
  courseId             String @map("CourseId") @db.Char(36)
  prerequisiteCourseId String @map("PrerequisiteCourseId") @db.Char(36)

  course       Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("CourseRequiredBy", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
  @@index([prerequisiteCourseId])
  @@map("CoursePrerequisites")
}

model Module {
  id               String   @id @map("Id") @db.Char(36)
  courseId         String   @map("CourseId") @db.Char(36)
  title            String   @map("Title") @db.VarChar(200)
  description      String?  @map("Description") @db.Text
  sortOrder        Int      @default(0) @map("SortOrder")
  isPublished      Boolean  @default(true) @map("IsPublished")
  estimatedMinutes Int?     @map("EstimatedMinutes")
  createdAt        DateTime @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt        DateTime @updatedAt @map("UpdatedAt") @db.DateTime(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@map("Modules")
}

model Lesson {
  id              String     @id @map("Id") @db.Char(36)
  moduleId        String     @map("ModuleId") @db.Char(36)
  title           String     @map("Title") @db.VarChar(200)
  description     String?    @map("Description") @db.Text
  lessonType      LessonType @default(TEXT) @map("LessonType")
  content         String?    @map("Content") @db.LongText
  contentUrl      String?    @map("ContentUrl") @db.VarChar(2000)
  h5pContentId    String?    @map("H5PContentId") @db.Char(36)
  sortOrder       Int        @default(0) @map("SortOrder")
  durationMinutes Int?       @map("DurationMinutes")
  isPublished     Boolean    @default(true) @map("IsPublished")
  createdAt       DateTime   @default(now()) @map("CreatedAt") @db.DateTime(6)
  updatedAt       DateTime   @updatedAt @map("UpdatedAt") @db.DateTime(6)

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  standards LessonStandard[]
  summaries LessonSummary[]

  completions LessonCompletion[]

  lessonPlans   LessonPlan[]
  teacherDrafts TeacherDraft[]

  @@index([moduleId, sortOrder])
  @@map("Lessons")
}

model Class {
  id                 String       @id @map("Id") @db.Char(36)
  organizationId     String       @map("OrganizationId") @db.Char(36)
  courseId           String       @map("CourseId") @db.Char(36)
  name               String       @map("Name") @db.VarChar(200)
  section            String?      @map("Section") @db.VarChar(50)
  term               String       @map("Term") @db.VarChar(50)
  startDate          DateTime?    @map("StartDate") @db.Date
  endDate            DateTime?    @map("EndDate") @db.Date
  room               String?      @map("Room") @db.VarChar(100)
  meetingSchedule    String?      @map("MeetingSchedule") @db.Text
  maxStudents        Int?         @map("MaxStudents")
  periodLabel        String?      @map("PeriodLabel") @db.VarChar(50)
  academicYearId     String?      @map("AcademicYearId") @db.Char(36)
  termId             String?      @map("TermId") @db.Char(36)
  periodId           String?      @map("PeriodId") @db.Char(36)
  gradeLevel         String?      @map("GradeLevel") @db.VarChar(16)
  gradingMode        GradingMode  @default(POINTS) @map("GradingMode")
  proficiencyScaleId String?      @map("ProficiencyScaleId") @db.Char(36)
  latePolicy         String?      @map("LatePolicy") @db.Text
