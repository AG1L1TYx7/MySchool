# SmartSchool LMS API configuration. Copy to .env; never commit .env.

NODE_ENV=development
PORT=5000

# XAMPP MariaDB (dev). Create the user and databases per docs/07-BUILD-PLAN.md section 4.4.
# XAMPP MariaDB. On the development machine XAMPP listens on 3307 because a MySQL 8 service holds 3306 (docs/07 section 2.1).
DATABASE_URL=mysql://smartschool:CHANGE_ME@127.0.0.1:3307/smartschooldb

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ISSUER=SmartSchoolApi
JWT_AUDIENCE=SmartSchoolClients
JWT_ACCESS_TTL_MINUTES=15
JWT_REMEMBER_ME_TTL_DAYS=30
JWT_REFRESH_TTL_DAYS=7
# Optional: base64 of 32 random bytes for encrypting TOTP secrets at rest (derived from JWT_SECRET when empty)
ENCRYPTION_KEY=

# Python AI service (apps/ai)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_TUTOR_DAILY_LIMIT=150
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_GENERATION_TIMEOUT_MS=120000
# Token the AI service presents when it calls back into /api/ai/h5p/*
AI_CALLBACK_TOKEN=CHANGE_ME

# Optional infrastructure (leave empty for in-memory defaults)
REDIS_URL=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.jpg,.jpeg,.png,.gif,.zip

# Providers: enabled when credentials are present
SMTP_HOST=
SMTP_PORT=25
MAIL_FROM=noreply@smartschool.local
MAIL_FROM_NAME=SmartSchool
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Multi-tenancy
TENANT_REQUIRED=false
TENANT_BASE_DOMAIN=localhost

LOG_LEVEL=info

# Authentication policy (docs/11 section 3). Unset = secure default in production.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true        # default: true in production, false otherwise
# AUTH_MFA_REQUIRED_ROLES=super_admin,superintendent,principal   # default in production
# AUTH_COOKIE_SECURE=true                     # default: true in production
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_REMEMBER_ME_ABSOLUTE_DAYS=90
WEB_APP_URL=http://localhost:3000

# Requests per minute per client IP (raise for load tests)
RATE_LIMIT_PER_MINUTE=100
