AI_ENV=development
AI_HOST=127.0.0.1
AI_PORT=8000
# Must equal AI_SERVICE_API_KEY in apps/api/.env
AI_SERVICE_TOKEN=CHANGE_ME_service_token_0123456789
# Read-only LMS tool API; must equal AI_CALLBACK_TOKEN in apps/api/.env
LMS_URL=http://localhost:5000
LMS_SERVICE_TOKEN=CHANGE_ME_callback_token_0123456789
MODEL_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBEDDING_MODEL=all-minilm
VISION_MODEL=llava
TUTOR_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=4
SAFETY_MODEL_CHECK=false
TRACE_SALT=change-me-in-production
